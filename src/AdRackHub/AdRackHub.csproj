<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.68.0.3547" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Imports\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\Imports\*.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data\Uploads\**" />
    <Content Remove="Data\Uploads\**" />
    <None Remove="App_Data\Uploads\**" />
    <None Remove="Data\Uploads\**" />
  </ItemGroup>

  <Target Name="RemoveUploadedFilesFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedUploadFiles Include="$(PublishDir)App_Data\Uploads\**\*" />
      <PublishedUploadFiles Include="$(PublishDir)Data\Uploads\**\*" />
    </ItemGroup>
    <Delete Files="@(PublishedUploadFiles)" />
  </Target>

  <ItemGroup>
    <None Include="..\..\scripts\export_routes.py" Link="scripts\export_routes.py" />
  </ItemGroup>

</Project>
