@model CustomerContractEditViewModel
@{
    ViewData["Title"] = "Edit Contract";
    var customerId = (int)(ViewBag.CustomerId ?? Model.Contract.CustomerId);
}

<h1 class="h2 mb-4">Edit Contract — @ViewBag.CustomerName</h1>
<form asp-controller="CustomerContracts" asp-action="Edit" asp-route-customerId="@customerId" method="post">
    <input type="hidden" name="customerId" value="@customerId" />
    <partial name="_CustomerContractForm" />
    <button type="submit" class="btn btn-primary">Save Contract</button>
    @if (Model.Contract.Id > 0)
    {
        <a asp-action="AgreementPdf" asp-route-id="@Model.Contract.Id" class="btn btn-outline-primary" target="_blank">@(Model.Contract.IsProposal ? "Print proposal PDF" : "Print contract PDF")</a>
        <button type="button" class="btn btn-outline-secondary" data-duplicate-contract data-contract-id="@Model.Contract.Id">Duplicate</button>
    }
    <a asp-controller="Customers" asp-action="Details" asp-route-id="@customerId" class="btn btn-outline-secondary">Cancel</a>
</form>

<partial name="_DuplicateModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
