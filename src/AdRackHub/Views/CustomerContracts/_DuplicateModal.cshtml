<div class="modal fade" id="duplicateContractModal" tabindex="-1" aria-labelledby="duplicateContractTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-controller="CustomerContracts" asp-action="CreateDuplicate" method="post" id="duplicateContractForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="duplicateContractId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="duplicateContractTitle">Duplicate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="duplicateIncreasePercent">Increase %</label>
                        <input type="number" class="form-control" id="duplicateIncreasePercent" name="increasePercent" value="0" step="0.01" />
                        <div class="form-text">0 keeps the monthly price. Any other percent changes it and rounds each monthly fee to the nearest dollar.</div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isProposal" value="true" id="duplicateIsProposal" checked />
                        <label class="form-check-label" for="duplicateIsProposal">This is a proposal</label>
                        <div class="form-text">Prints as a proposal and stays off billing.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="duplicateContractName">Contract name</label>
                        <input type="text" class="form-control" id="duplicateContractName" name="contractName" maxlength="200" required />
                        <div class="form-text d-none" id="duplicateNameNote"></div>
                    </div>
                    <div class="mb-3" id="duplicateTerm"></div>
                    <div id="duplicateRouteList" class="text-muted">Loading…</div>
                    <div class="d-flex justify-content-between fw-semibold mt-3">
                        <span>Monthly total</span>
                        <span id="duplicateMonthlyTotal">$0</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="duplicateSubmitButton">Create proposal</button>
                </div>
            </form>
        </div>
    </div>
</div>
