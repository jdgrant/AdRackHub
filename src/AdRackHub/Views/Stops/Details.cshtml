@model Stop
@{
    ViewData["Title"] = Model.StopName;
}

<div class="page-header">
    <h1 class="h2 mb-0">@Model.StopName</h1>
    <div>
        @if (Model.Status == StopStatus.Active)
        {
            <form asp-action="LogVisit" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-success">Log Visit</button>
            </form>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Route</dt>
    <dd class="col-sm-9"><a asp-controller="Routes" asp-action="Details" asp-route-id="@Model.RouteId">@Model.Route.RouteName</a></dd>
    <dt class="col-sm-3">Step #</dt>
    <dd class="col-sm-9">@(Model.StepNumber?.ToString() ?? "—")</dd>
    <dt class="col-sm-3">Rack Placement</dt>
    <dd class="col-sm-9">@(Model.RackPlacement ?? "—")</dd>
    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">
        @if (Model.StopType == StopType.ProspectStop)
        {
            <span class="badge bg-info text-dark">Prospect Stop</span>
        }
        else
        {
            @Model.StopType
        }
    </dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@(Model.Address ?? "—")</dd>
    <dt class="col-sm-3">City / State / Zip</dt>
    <dd class="col-sm-9">@string.Join(", ", new[] { Model.City, Model.State, Model.Zip }.Where(s => !string.IsNullOrEmpty(s)))</dd>
    <dt class="col-sm-3">Highway / Exit</dt>
    <dd class="col-sm-9">@(Model.HighwayExit ?? "—")</dd>
    <dt class="col-sm-3">Coordinates</dt>
    <dd class="col-sm-9">
        @(Model.Latitude.HasValue && Model.Longitude.HasValue
            ? $"{Model.Latitude:0.######}, {Model.Longitude:0.######}"
            : "—")
    </dd>
    <dt class="col-sm-3">Place ID</dt>
    <dd class="col-sm-9"><span class="small text-muted">@(Model.PlaceId ?? "—")</span></dd>
    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(Model.Notes ?? "—")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Last Visited</dt>
    <dd class="col-sm-9">@VisitDisplay.Format(Model.LastVisitedAt)</dd>
</dl>

@if (Model.Status == StopStatus.Active)
{
    <h3 class="h5 mt-4">Log a visit</h3>
    <form asp-action="LogPhotoVisit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card mb-4">
        <div class="card-body">
            <p class="text-muted">Upload the before and after photos and name the driver who made the stop.</p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="visit-driver">Driver</label>
                    <input class="form-control" id="visit-driver" name="driverName" maxlength="200" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="visit-when">Visited</label>
                    <input class="form-control" id="visit-when" name="visitedAt" type="datetime-local" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="visit-notes">Notes</label>
                    <input class="form-control" id="visit-notes" name="notes" maxlength="1000" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="visit-before">Before photo</label>
                    <input class="form-control" id="visit-before" name="beforePhoto" type="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="visit-after">After photo</label>
                    <input class="form-control" id="visit-after" name="afterPhoto" type="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
                </div>
            </div>
            <button type="submit" class="btn btn-success mt-3">Log Visit</button>
        </div>
    </form>
}

<h3 class="h5 mt-4">Visit History</h3>
@if (Model.Visits.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Visited At</th>
                <th>Driver</th>
                <th>Before</th>
                <th>After</th>
                <th>Visited By</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var visit in Model.Visits)
        {
            var before = visit.Photos.FirstOrDefault(p => p.Kind == StopVisitPhotoKind.Before);
            var after = visit.Photos.FirstOrDefault(p => p.Kind == StopVisitPhotoKind.After);
            <tr>
                <td>@VisitDisplay.Format(visit.VisitedAt)</td>
                <td>@(visit.DriverName ?? "—")</td>
                <td>
                    @if (before != null)
                    {
                        <a asp-action="VisitPhoto" asp-route-id="@before.Id"><img src="@Url.Action("VisitPhoto", new { id = before.Id })" alt="Before" style="height:64px" /></a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @if (after != null)
                    {
                        <a asp-action="VisitPhoto" asp-route-id="@after.Id"><img src="@Url.Action("VisitPhoto", new { id = after.Id })" alt="After" style="height:64px" /></a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@(visit.VisitedByName ?? "—")</td>
                <td>@(visit.Notes ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No visits logged yet.</p>
}

<h3 class="h5 mt-4">Customers at this stop</h3>
@{
    var customers = Model.CustomerRouteStops
        .Select(crs => crs.CustomerRoute)
        .Where(cr => cr.Status == CustomerRouteStatus.Active)
        .Select(cr => cr.Customer)
        .DistinctBy(c => c.Id)
        .ToList();
}
@if (customers.Any())
{
    <ul>
    @foreach (var customer in customers)
    {
        <li><a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">@customer.CustomerName</a></li>
    }
    </ul>
}
else
{
    <p class="text-muted">No customers assigned to this stop.</p>
}
