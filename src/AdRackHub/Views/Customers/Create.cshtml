@model Customer
@{
    ViewData["Title"] = "Add " + CustomerTypeLabels.Singular(Model.Type);
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>
<form asp-action="Create" method="post">
    <partial name="_CustomerForm" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="@CustomerTypeLabels.Controller(Model.Type)" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
