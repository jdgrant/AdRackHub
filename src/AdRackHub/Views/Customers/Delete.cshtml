@model Customer
@{
    var isProspect = Model.Type == CustomerType.Prospect;
    ViewData["Title"] = isProspect ? "Delete Prospect" : "Delete Customer";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>
<p>Are you sure you want to delete <strong>@Model.CustomerName</strong>? This will also remove all contacts and route assignments.</p>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="@(isProspect ? "Prospects" : "Customers")" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
