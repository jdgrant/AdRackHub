@model Customer
@using AdRackHub.Services
@{
    ViewData["Title"] = Model.CustomerName;
    var isProspectLike = CustomerTypeLabels.IsProspectLike(Model.Type);
    var listController = CustomerTypeLabels.Controller(Model.Type);
    var listTitle = CustomerTypeLabels.Plural(Model.Type);
    var activeTab = (ViewBag.ActiveTab as string) ?? "activity";
    var listSearch = ViewBag.ListSearch as string;
    var listStatus = ViewBag.ListStatus as CustomerStatus?;
    var listHighValue = ViewBag.ListHighValue as bool? == true;
    var listNeedsMoreInfo = ViewBag.ListNeedsMoreInfo as bool? == true;
    string NoteStatusBadge(CustomerNoteStatus status) => status switch
    {
        CustomerNoteStatus.Working => "bg-warning text-dark",
        CustomerNoteStatus.Done => "bg-success",
        _ => "bg-primary"
    };
    var previousId = ViewBag.PreviousCustomerId as int?;
    var nextId = ViewBag.NextCustomerId as int?;
    var navPosition = ViewBag.NavPosition as int? ?? 0;
    var navTotal = ViewBag.NavTotal as int? ?? 0;
    var billingContacts = Model.Contacts.Where(c => c.Role == ContactRole.Billing || c.Role == ContactRole.Primary).ToList();
    var primaryContact = Model.Contacts.FirstOrDefault(c => c.Role == ContactRole.Primary)
        ?? Model.Contacts.FirstOrDefault();
    var draftContact = new Contact
    {
        CustomerId = Model.Id,
        Name = TempData["ContactName"]?.ToString() ?? "",
        FirstName = TempData["ContactFirstName"]?.ToString(),
        LastName = TempData["ContactLastName"]?.ToString(),
        Email = TempData["ContactEmail"]?.ToString(),
        Phone = TempData["ContactPhone"]?.ToString(),
        CellPhone = TempData["ContactCellPhone"]?.ToString(),
        Address = TempData["ContactAddress"]?.ToString(),
        City = TempData["ContactCity"]?.ToString(),
        State = TempData["ContactState"]?.ToString(),
        Zip = TempData["ContactZip"]?.ToString(),
        WebUrl = TempData["ContactWebUrl"]?.ToString(),
        Role = Enum.TryParse<ContactRole>(TempData["ContactRole"]?.ToString(), out var role) ? role : ContactRole.Primary,
        SendInvoice = string.Equals(TempData["ContactSendInvoice"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
    };
    ViewBag.ShowContactModal = TempData["ShowContactModal"] != null || string.Equals(Context.Request.Query["addContact"], "1", StringComparison.Ordinal);
    var activeContractRoutes = Model.Contracts
        .Where(c => BillingDueCalculator.IsActiveContract(c))
        .SelectMany(c => c.ContractRoutes.Select(cbr => new { Contract = c, ContractRoute = cbr }))
        .OrderBy(x => x.ContractRoute.Route.RouteName)
        .ThenBy(x => x.Contract.ContractName)
        .ToList();
    var customerRoutesByRouteId = Model.CustomerRoutes
        .Where(cr => cr.Status == CustomerRouteStatus.Active)
        .GroupBy(cr => cr.RouteId)
        .ToDictionary(g => g.Key, g => g.First());
    var contractedRouteOutlines = activeContractRoutes
        .GroupBy(x => x.ContractRoute.RouteId)
        .Select(g =>
        {
            var route = g.First().ContractRoute.Route;
            customerRoutesByRouteId.TryGetValue(g.Key, out var customerRoute);
            var allStops = customerRoute?.AllStops ?? true;
            IEnumerable<Stop> stops;
            if (customerRoute == null || customerRoute.AllStops)
            {
                stops = route.Stops
                    .Where(s => s.Status == StopStatus.Active)
                    .OrderBy(s => s.StepNumber.HasValue ? 0 : 1)
                    .ThenBy(s => s.StepNumber)
                    .ThenBy(s => s.StopName);
            }
            else
            {
                stops = customerRoute.CustomerRouteStops
                    .Select(crs => crs.Stop)
                    .Where(s => s != null && s.Status == StopStatus.Active)
                    .OrderBy(s => s.StepNumber.HasValue ? 0 : 1)
                    .ThenBy(s => s.StepNumber)
                    .ThenBy(s => s.StopName)!;
            }

            return new
            {
                Route = route,
                CustomerRoute = customerRoute,
                AllStops = allStops,
                Stops = stops.ToList(),
                Contracts = g.Select(x => x.Contract).GroupBy(c => c.Id).Select(cg => cg.First()).OrderBy(c => c.ContractName).ToList()
            };
        })
        .OrderBy(x => x.Route.RouteName)
        .ToList();
    var latestBrochure = Model.BrochureScans
        .OrderByDescending(s => s.UploadedAt)
        .FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
}

<div class="crm-record">
    <div class="crm-header">
        <div class="d-flex gap-3 align-items-start flex-grow-1 min-w-0">
            <div class="min-w-0">
                <div class="text-muted small mb-1">
                    <a asp-controller="@listController"
                       asp-action="Index"
                       asp-route-search="@listSearch"
                       asp-route-status="@listStatus"
                       asp-route-highValue="@(listHighValue ? "true" : "")"
                       asp-route-needsMoreInfo="@(listNeedsMoreInfo ? "true" : "")"
                       class="text-decoration-none">@listTitle</a>
                    <span class="mx-1">/</span>
                    <span>Record</span>
                </div>
                <h1 class="h3 mb-2 text-truncate" title="@Model.CustomerName">
                    <span class="d-inline-flex align-items-center gap-2">
                        <span class="text-truncate">@Model.CustomerName</span>
                        <partial name="_FlagIcons" model="Model" />
                    </span>
                </h1>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge @CustomerTypeLabels.BadgeClass(Model.Type)">@CustomerTypeLabels.Singular(Model.Type)</span>
                    <span class="badge @(Model.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@Model.Status</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <a href="tel:@Model.Phone" class="text-decoration-none small">@Model.Phone</a>
                    }
                    @if (isProspectLike && Model.IsHighValueProspect)
                    {
                        <span class="badge crm-badge-high-value">★ High Value</span>
                    }
                    @if (Model.NeedsMoreInfo)
                    {
                        <span class="badge crm-badge-needs-info">Needs More Info</span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (!isProspectLike && ViewBag.ContractedCustomersByRoute is List<ContractedRouteCustomerGroup> contractedGroups && contractedGroups.Count > 0)
            {
                ViewData["SelectedContractedCustomerId"] = Model.Id;
                <div class="contracted-customer-jump-wrap">
                    <partial name="_ContractedCustomerJump" model="contractedGroups" />
                </div>
            }
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Edit
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">Edit details</a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    @if (isProspectLike)
                    {
                        <li>
                            <form asp-action="ToggleHighValue" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="dropdown-item">
                                    @(Model.IsHighValueProspect ? "Clear High Value" : "Mark High Value")
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <form asp-action="ToggleAtRisk" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="dropdown-item @(Model.IsAtRisk ? "" : "text-danger")">
                                    @(Model.IsAtRisk ? "Clear At Risk" : "Mark At Risk")
                                </button>
                            </form>
                        </li>
                    }
                    @if (Model.Type != CustomerType.Customer)
                    {
                        <li>
                            <form asp-action="ToggleType" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="toType" value="@CustomerType.Customer" />
                                <button type="submit" class="dropdown-item">Make Customer</button>
                            </form>
                        </li>
                    }
                    @if (Model.Type != CustomerType.Prospect)
                    {
                        <li>
                            <form asp-action="ToggleType" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="toType" value="@CustomerType.Prospect" />
                                <button type="submit" class="dropdown-item">Make Prospect</button>
                            </form>
                        </li>
                    }
                    @if (Model.Type != CustomerType.ExpandedProspect)
                    {
                        <li>
                            <form asp-action="ToggleType" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="toType" value="@CustomerType.ExpandedProspect" />
                                <button type="submit" class="dropdown-item">Make Expanded Prospect</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
            <div class="btn-group" role="group" aria-label="Record navigation">
                @if (previousId.HasValue)
                {
                    <a asp-action="Details"
                       asp-route-id="@previousId.Value"
                       asp-route-search="@listSearch"
                       asp-route-status="@listStatus"
                       asp-route-highValue="@(listHighValue ? "true" : "")"
                       asp-route-needsMoreInfo="@(listNeedsMoreInfo ? "true" : "")"
                       class="btn btn-outline-secondary"
                       title="Previous in list">&lt;</a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" disabled title="Previous in list">&lt;</button>
                }
                @if (nextId.HasValue)
                {
                    <a asp-action="Details"
                       asp-route-id="@nextId.Value"
                       asp-route-search="@listSearch"
                       asp-route-status="@listStatus"
                       asp-route-highValue="@(listHighValue ? "true" : "")"
                       asp-route-needsMoreInfo="@(listNeedsMoreInfo ? "true" : "")"
                       class="btn btn-outline-secondary"
                       title="Next in list">&gt;</a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" disabled title="Next in list">&gt;</button>
                }
            </div>
            @if (navTotal > 0 && navPosition > 0)
            {
                <span class="align-self-center text-muted small text-nowrap">@navPosition of @navTotal</span>
            }
            <a asp-controller="@listController"
               asp-action="Index"
               asp-route-search="@listSearch"
               asp-route-status="@listStatus"
               asp-route-highValue="@(listHighValue ? "true" : "")"
               asp-route-needsMoreInfo="@(listNeedsMoreInfo ? "true" : "")"
               class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8 order-2 order-lg-2">
            <ul class="nav nav-tabs crm-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "activity" ? "active" : "")" id="tab-activity-btn" data-bs-toggle="tab" data-bs-target="#tab-activity" type="button" role="tab">Activity</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "contacts" ? "active" : "")" id="tab-contacts-btn" data-bs-toggle="tab" data-bs-target="#tab-contacts" type="button" role="tab">
                        Contacts
                        @if (Model.Contacts.Count > 0)
                        {
                            <span class="badge rounded-pill bg-secondary ms-1">@Model.Contacts.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "brochures" ? "active" : "")" id="tab-brochures-btn" data-bs-toggle="tab" data-bs-target="#tab-brochures" type="button" role="tab">
                        Brochures
                        @if (Model.BrochureScans.Count > 0)
                        {
                            <span class="badge rounded-pill bg-secondary ms-1">@Model.BrochureScans.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "map" ? "active" : "")" id="tab-map-btn" data-bs-toggle="tab" data-bs-target="#tab-map" type="button" role="tab">Map</button>
                </li>
                @if (!isProspectLike)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "routes" ? "active" : "")" id="tab-routes-btn" data-bs-toggle="tab" data-bs-target="#tab-routes" type="button" role="tab">
                            Routes
                            @if (contractedRouteOutlines.Count > 0)
                            {
                                <span class="badge rounded-pill bg-secondary ms-1">@contractedRouteOutlines.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "contracts" ? "active" : "")" id="tab-contracts-btn" data-bs-toggle="tab" data-bs-target="#tab-contracts" type="button" role="tab">
                            Contracts
                            @if (Model.Contracts.Count > 0)
                            {
                                <span class="badge rounded-pill bg-secondary ms-1">@Model.Contracts.Count</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content crm-tab-content">
                <div class="tab-pane fade @(activeTab == "activity" ? "show active" : "")" id="tab-activity" role="tabpanel">
                    <div class="crm-panel">
                        <form asp-action="AddNote" method="post" class="crm-composer mb-4">
                            <input type="hidden" name="customerId" value="@Model.Id" />
                            <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                <div class="fw-semibold">Log activity</div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <select class="form-select form-select-sm w-auto" name="kind" data-activity-kind>
                                        @foreach (var kindOption in EnumDisplay.ActivityKinds())
                                        {
                                            <option value="@kindOption">@kindOption.Name()</option>
                                        }
                                    </select>
                                    <select class="form-select form-select-sm w-auto" name="status" asp-items="Html.GetEnumSelectList<CustomerNoteStatus>()"></select>
                                    <input class="form-control form-control-sm w-auto" type="date" name="dueDate" title="Due date" data-activity-due />
                                </div>
                            </div>
                            <textarea class="form-control mb-2" name="body" rows="3" maxlength="4000" required placeholder="Log a note, call, email, meeting, task, or action…"></textarea>
                            <button type="submit" class="btn btn-primary btn-sm">Add to timeline</button>
                        </form>

                        @if (Model.Notes.Any())
                        {
                            <div class="crm-timeline">
                            @foreach (var note in Model.Notes)
                            {
                                <div class="crm-timeline-item" id="note-@note.Id">
                                    <div class="crm-timeline-dot"></div>
                                    <div class="crm-timeline-body">
                                        <div class="d-flex justify-content-between gap-2 align-items-start">
                                            <div>
                                                <span class="badge bg-secondary">@note.Kind.Name()</span>
                                                <span class="badge @NoteStatusBadge(note.Status)">@note.Status</span>
                                                <span class="text-muted small ms-1">
                                                    @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                                    @if (note.DueDate.HasValue)
                                                    {
                                                        <span class="@(note.IsOverdue ? "text-danger fw-semibold" : "")">
                                                            · Due @note.DueDate.Value.ToString("MMM d, yyyy")
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(note.CreatedBy))
                                                    {
                                                        <span>· @note.CreatedBy</span>
                                                    }
                                                </span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-link p-0"
                                                        onclick="document.getElementById('note-view-@note.Id').classList.add('d-none'); document.getElementById('note-edit-@note.Id').classList.remove('d-none');">
                                                    Edit
                                                </button>
                                                <form asp-action="DeleteNote" method="post">
                                                    <input type="hidden" name="id" value="@note.Id" />
                                                    <input type="hidden" name="customerId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" onclick="return confirm('Delete this note?');">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                        <div id="note-view-@note.Id" class="mt-2 crm-pre">@note.Body</div>
                                        <form asp-action="EditNote" method="post" id="note-edit-@note.Id" class="mt-2 d-none">
                                            <input type="hidden" name="id" value="@note.Id" />
                                            <input type="hidden" name="customerId" value="@Model.Id" />
                                            <div class="d-flex justify-content-end mb-2 gap-2 flex-wrap">
                                                <select class="form-select form-select-sm w-auto" name="kind" data-activity-kind>
                                                    @foreach (var kindOption in EnumDisplay.ActivityKinds())
                                                    {
                                                        if (kindOption == note.Kind)
                                                        {
                                                            <option value="@kindOption" selected>@kindOption.Name()</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@kindOption">@kindOption.Name()</option>
                                                        }
                                                    }
                                                </select>
                                                <select class="form-select form-select-sm w-auto" name="status">
                                                    @foreach (CustomerNoteStatus statusOption in Enum.GetValues(typeof(CustomerNoteStatus)))
                                                    {
                                                        if (statusOption == note.Status)
                                                        {
                                                            <option value="@statusOption" selected>@statusOption</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@statusOption">@statusOption</option>
                                                        }
                                                    }
                                                </select>
                                                <input class="form-control form-control-sm w-auto" type="date" name="dueDate" value="@(note.DueDate?.ToString("yyyy-MM-dd"))" title="Due date" data-activity-due />
                                            </div>
                                            <textarea class="form-control mb-2" name="body" rows="3" maxlength="4000" required>@note.Body</textarea>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        onclick="document.getElementById('note-edit-@note.Id').classList.add('d-none'); document.getElementById('note-view-@note.Id').classList.remove('d-none');">
                                                    Cancel
                                                </button>
                                            </div>
                                        </form>
                                        <div class="crm-subnotes">
                                            @foreach (var sub in note.SubNotes)
                                            {
                                                <div class="crm-subnote">
                                                    <div class="d-flex justify-content-between gap-2 align-items-start">
                                                        <div class="text-muted small">
                                                            @sub.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                                            @if (!string.IsNullOrWhiteSpace(sub.CreatedBy))
                                                            {
                                                                <span>· @sub.CreatedBy</span>
                                                            }
                                                        </div>
                                                        <form asp-action="DeleteSubNote" method="post">
                                                            <input type="hidden" name="id" value="@sub.Id" />
                                                            <input type="hidden" name="noteId" value="@note.Id" />
                                                            <input type="hidden" name="customerId" value="@Model.Id" />
                                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" onclick="return confirm('Delete this sub-note?');">Delete</button>
                                                        </form>
                                                    </div>
                                                    <div class="crm-pre mt-1">@sub.Body</div>
                                                </div>
                                            }
                                            <form asp-action="AddSubNote" method="post" class="crm-subnote-form">
                                                <input type="hidden" name="noteId" value="@note.Id" />
                                                <input type="hidden" name="customerId" value="@Model.Id" />
                                                <textarea class="form-control form-control-sm mb-2" name="body" rows="2" maxlength="2000" required placeholder="Add a sub-note…"></textarea>
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Add sub-note</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No activity yet. Log your first note above.</p>
                        }
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "contacts" ? "show active" : "")" id="tab-contacts" role="tabpanel">
                    <div class="crm-panel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="fw-semibold">People</div>
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addContactModal">Add Contact</button>
                        </div>
                        @if (Model.Contacts.Any())
                        {
                            <div class="row g-3">
                            @foreach (var contact in Model.Contacts)
                            {
                                <div class="col-md-6">
                                    <div class="crm-contact-card h-100">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">@contact.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(contact.PersonName))
                                                {
                                                    <div class="small">@contact.PersonName</div>
                                                }
                                                <div class="small text-muted">@contact.Role</div>
                                            </div>
                                            <a asp-controller="Contacts" asp-action="Edit" asp-route-id="@contact.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        </div>
                                        <div class="small mt-2">
                                            <div>@(contact.Email ?? "—")</div>
                                            <div>Tel: @(contact.Phone ?? "—")</div>
                                            <div>Cell: @(contact.CellPhone ?? "—")</div>
                                            <div class="text-muted">@string.Join(", ", new[] { contact.Address, contact.City, contact.State, contact.Zip }.Where(s => !string.IsNullOrEmpty(s)).DefaultIfEmpty("—"))</div>
                                            @if (!string.IsNullOrWhiteSpace(contact.WebUrl))
                                            {
                                                <div><a href="@contact.WebUrl" target="_blank" rel="noopener noreferrer">@contact.WebUrl</a></div>
                                            }
                                        </div>
                                        <form asp-controller="Contacts" asp-action="ToggleSendInvoice" method="post" class="mt-3 mb-0">
                                            <input type="hidden" name="id" value="@contact.Id" />
                                            <input type="hidden" name="sendInvoice" value="@(!contact.SendInvoice)" />
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       id="sendInvoice-@contact.Id"
                                                       @(contact.SendInvoice ? "checked" : null)
                                                       onchange="this.form.submit()" />
                                                <label class="form-check-label" for="sendInvoice-@contact.Id">Send Invoice</label>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No contacts yet.</p>
                        }
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "brochures" ? "show active" : "")" id="tab-brochures" role="tabpanel">
                    <div class="crm-panel">
                        @if (Model.BrochureScans.Any())
                        {
                            <div class="row g-3 mb-4">
                            @foreach (var scan in Model.BrochureScans)
                            {
                                var sizeLabel = scan.FileSizeBytes < 1024 * 1024
                                    ? $"{scan.FileSizeBytes / 1024.0:0.#} KB"
                                    : $"{scan.FileSizeBytes / (1024.0 * 1024.0):0.#} MB";
                                <div class="col-md-6 col-xl-4">
                                    <div class="crm-brochure-card h-100">
                                        @if (scan.IsImage)
                                        {
                                            <button type="button"
                                                    class="brochure-scan-preview brochure-preview-trigger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#brochurePreviewModal"
                                                    data-brochure-url="@Url.Action("ViewBrochureScan", new { id = scan.Id })"
                                                    data-brochure-title="@scan.OriginalFileName"
                                                    data-brochure-type="image">
                                                <img src="@Url.Action("ViewBrochureScan", new { id = scan.Id })" class="brochure-scan-thumb" alt="@scan.OriginalFileName" />
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="brochure-scan-preview brochure-scan-preview-pdf text-center">
                                                <div class="display-6 text-danger mb-2">PDF</div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary brochure-preview-trigger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#brochurePreviewModal"
                                                        data-brochure-url="@Url.Action("ViewBrochureScan", new { id = scan.Id })"
                                                        data-brochure-title="@scan.OriginalFileName"
                                                        data-brochure-type="pdf">
                                                    Open PDF
                                                </button>
                                            </div>
                                        }
                                        <div class="pt-2">
                                            <div class="small fw-semibold text-truncate" title="@scan.OriginalFileName">@scan.OriginalFileName</div>
                                            <div class="text-muted small">@scan.UploadedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") · @sizeLabel</div>
                                            @if (!string.IsNullOrWhiteSpace(scan.Notes))
                                            {
                                                <div class="small mt-1 brochure-scan-notes">@scan.Notes</div>
                                            }
                                            <form asp-action="DeleteBrochureScan" method="post" class="mt-2">
                                                <input type="hidden" name="id" value="@scan.Id" />
                                                <input type="hidden" name="customerId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this brochure scan?');">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No brochure scans yet.</p>
                        }

                        <form asp-action="UploadBrochureScan" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="crm-composer">
                            <div class="fw-semibold mb-2">Upload scan</div>
                            <div class="mb-2">
                                <input type="file" class="form-control" name="file" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,image/*,application/pdf" required />
                                <div class="form-text">PDF or image, up to 20 MB. PDFs are converted to PNG.</div>
                            </div>
                            <div class="mb-2">
                                <textarea class="form-control" name="notes" rows="2" maxlength="2000" placeholder="Optional description"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Upload</button>
                        </form>

                        <hr class="my-4" />

                        <div class="fw-semibold mb-2">Warehouse inventory</div>
                        <p class="text-muted small mb-3">Log a monthly count and the rack/bin where these brochures sit in the warehouse.</p>

                        <div class="crm-warehouse-location mb-3">
                            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                                <span class="text-muted small">Current location</span>
                                @if (!string.IsNullOrWhiteSpace(Model.WarehouseLocationLabel))
                                {
                                    <span class="fw-semibold">@Model.WarehouseLocationLabel</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </div>
                            <form asp-action="SaveWarehouseLocation" method="post" class="row g-2 align-items-end">
                                <input type="hidden" name="customerId" value="@Model.Id" />
                                <div class="col-6 col-sm-3 col-md-2">
                                    <label class="form-label small mb-1" for="warehouseRack">Rack</label>
                                    <input type="text" class="form-control" id="warehouseRack" name="rack" maxlength="50" value="@Model.WarehouseRack" placeholder="e.g. 4" />
                                </div>
                                <div class="col-6 col-sm-3 col-md-2">
                                    <label class="form-label small mb-1" for="warehouseBin">Bin</label>
                                    <input type="text" class="form-control" id="warehouseBin" name="bin" maxlength="50" value="@Model.WarehouseBin" placeholder="e.g. B-12" />
                                </div>
                                <div class="col-sm-auto">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Save location</button>
                                </div>
                            </form>
                        </div>

                        <form asp-action="AddBrochureInventory" method="post" class="crm-composer mb-4">
                            <input type="hidden" name="customerId" value="@Model.Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-sm-6 col-md-2">
                                    <label class="form-label small mb-1" for="inventoryDate">Inventory date</label>
                                    <input type="date" class="form-control" id="inventoryDate" name="inventoryDate" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="col-sm-6 col-md-2">
                                    <label class="form-label small mb-1" for="quantity">Count</label>
                                    <input type="number" class="form-control" id="quantity" name="quantity" min="0" step="1" required placeholder="0" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small mb-1" for="inventoryRack">Rack</label>
                                    <input type="text" class="form-control" id="inventoryRack" name="rack" maxlength="50" value="@Model.WarehouseRack" placeholder="Optional" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small mb-1" for="inventoryBin">Bin</label>
                                    <input type="text" class="form-control" id="inventoryBin" name="bin" maxlength="50" value="@Model.WarehouseBin" placeholder="Optional" />
                                </div>
                                <div class="col-sm-12 col-md-3">
                                    <label class="form-label small mb-1" for="inventoryNotes">Notes</label>
                                    <input type="text" class="form-control" id="inventoryNotes" name="notes" maxlength="1000" placeholder="Optional" />
                                </div>
                                <div class="col-sm-auto">
                                    <button type="submit" class="btn btn-primary btn-sm">Log inventory</button>
                                </div>
                            </div>
                        </form>

                        @if (Model.BrochureInventories.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Inventory date</th>
                                            <th class="text-end">Count</th>
                                            <th>Rack</th>
                                            <th>Bin</th>
                                            <th>Notes</th>
                                            <th>Logged by</th>
                                            <th>Logged at</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in Model.BrochureInventories)
                                    {
                                        <tr id="inventory-view-@item.Id">
                                            <td>@item.InventoryDate.ToString("MMM d, yyyy")</td>
                                            <td class="text-end fw-semibold">@item.Quantity.ToString("N0")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Rack) ? "—" : item.Rack)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Bin) ? "—" : item.Bin)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                                            <td>@(item.CreatedBy ?? "—")</td>
                                            <td class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                        onclick="document.getElementById('inventory-view-@item.Id').classList.add('d-none'); document.getElementById('inventory-edit-@item.Id').classList.remove('d-none');">
                                                    Edit
                                                </button>
                                                <form asp-action="DeleteBrochureInventory" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="customerId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this inventory record?');">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <tr id="inventory-edit-@item.Id" class="d-none">
                                            <td colspan="8">
                                                <form asp-action="EditBrochureInventory" method="post" class="row g-2 align-items-end">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="customerId" value="@Model.Id" />
                                                    <div class="col-sm-6 col-md-2">
                                                        <label class="form-label small mb-1" for="inventoryDate-@item.Id">Inventory date</label>
                                                        <input type="date" class="form-control" id="inventoryDate-@item.Id" name="inventoryDate" value="@item.InventoryDate.ToString("yyyy-MM-dd")" required />
                                                    </div>
                                                    <div class="col-sm-6 col-md-2">
                                                        <label class="form-label small mb-1" for="quantity-@item.Id">Count</label>
                                                        <input type="number" class="form-control" id="quantity-@item.Id" name="quantity" min="0" step="1" value="@item.Quantity" required />
                                                    </div>
                                                    <div class="col-6 col-md-2">
                                                        <label class="form-label small mb-1" for="inventoryRack-@item.Id">Rack</label>
                                                        <input type="text" class="form-control" id="inventoryRack-@item.Id" name="rack" maxlength="50" value="@item.Rack" />
                                                    </div>
                                                    <div class="col-6 col-md-2">
                                                        <label class="form-label small mb-1" for="inventoryBin-@item.Id">Bin</label>
                                                        <input type="text" class="form-control" id="inventoryBin-@item.Id" name="bin" maxlength="50" value="@item.Bin" />
                                                    </div>
                                                    <div class="col-sm-12 col-md-3">
                                                        <label class="form-label small mb-1" for="inventoryNotes-@item.Id">Notes</label>
                                                        <input type="text" class="form-control" id="inventoryNotes-@item.Id" name="notes" maxlength="1000" value="@item.Notes" placeholder="Optional" />
                                                    </div>
                                                    <div class="col-sm-auto d-flex gap-2">
                                                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                                onclick="document.getElementById('inventory-edit-@item.Id').classList.add('d-none'); document.getElementById('inventory-view-@item.Id').classList.remove('d-none');">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No inventory records yet.</p>
                        }
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "map" ? "show active" : "")" id="tab-map" role="tabpanel">
                    <div class="crm-panel">
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            var mapAddress = CustomerAddressHelper.FormatFullAddress(Model.Address, Model.City, Model.State, Model.Zip);
                            <div id="customerMap"
                                 class="customer-map"
                                 data-lat="@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-lng="@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-name="@Model.CustomerName"
                                 data-address="@mapAddress"></div>
                            <div class="d-flex flex-wrap justify-content-between gap-2 mt-2">
                                <div class="text-muted small">
                                    @if (!string.IsNullOrWhiteSpace(mapAddress))
                                    {
                                        @mapAddress
                                        <span class="mx-1">·</span>
                                    }
                                    @Model.Latitude.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture),
                                    @Model.Longitude.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)
                                </div>
                                <a class="small"
                                   href="https://www.google.com/maps?q=@Uri.EscapeDataString($"{Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}")"
                                   target="_blank"
                                   rel="noopener">Open in Google Maps</a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-2">No coordinates yet. Add an address or enter latitude and longitude.</p>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit details</a>
                        }
                    </div>
                </div>

                @if (!isProspectLike)
                {
                    <div class="tab-pane fade @(activeTab == "routes" ? "show active" : "")" id="tab-routes" role="tabpanel">
                        <div class="crm-panel">
                            <div class="fw-semibold mb-3">Contracted routes &amp; stops</div>
                            @if (contractedRouteOutlines.Any())
                            {
                                @foreach (var outline in contractedRouteOutlines)
                                {
                                    <div class="crm-side-card mb-3">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <div>
                                                <div class="fw-semibold">
                                                    <a asp-controller="Routes" asp-action="Details" asp-route-id="@outline.Route.Id">@outline.Route.RouteName</a>
                                                </div>
                                                <div class="small text-muted">
                                                    @RouteProductHelper.Label(outline.Route.Product)
                                                    · @outline.Contracts.Count contract@(outline.Contracts.Count == 1 ? "" : "s"):
                                                    @string.Join(", ", outline.Contracts.Select(c => c.ContractName))
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                @if (outline.AllStops)
                                                {
                                                    <span class="badge bg-secondary">All stops</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">Selected stops</span>
                                                }
                                                <div class="small text-muted mt-1">@outline.Stops.Count stop@(outline.Stops.Count == 1 ? "" : "s")</div>
                                            </div>
                                        </div>
                                        @if (outline.Stops.Any())
                                        {
                                            <details>
                                                <summary class="small fw-semibold" style="cursor: pointer;">
                                                    Stops (@outline.Stops.Count)
                                                </summary>
                                                <div class="table-responsive mt-2">
                                                    <table class="table table-sm align-middle mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 4rem;">#</th>
                                                                <th>Stop</th>
                                                                <th>Type</th>
                                                                <th>Location</th>
                                                                <th>Highway / Exit</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                        @foreach (var stop in outline.Stops)
                                                        {
                                                            <tr>
                                                                <td class="text-muted">@(stop.StepNumber?.ToString() ?? "—")</td>
                                                                <td>
                                                                    <a asp-controller="Stops" asp-action="Details" asp-route-id="@stop.Id">@stop.StopName</a>
                                                                </td>
                                                                <td>@stop.StopType</td>
                                                                <td class="small text-muted">
                                                                    @string.Join(", ", new[] { stop.Address, stop.City, stop.State, stop.Zip }.Where(s => !string.IsNullOrWhiteSpace(s)).DefaultIfEmpty("—"))
                                                                </td>
                                                                <td class="small">@(stop.HighwayExit ?? "—")</td>
                                                            </tr>
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </details>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0 small">No stops selected for this route.</p>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">No contracted routes yet. Add a contract to assign routes and stops.</p>
                            }
                        </div>
                    </div>

                    <div class="tab-pane fade @(activeTab == "contracts" ? "show active" : "")" id="tab-contracts" role="tabpanel">
                        <div class="crm-panel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="fw-semibold">Contracts</div>
                                <a asp-controller="CustomerContracts" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-sm btn-primary">Add Contract</a>
                            </div>

                            <div class="crm-side-card mb-3">
                                <div class="text-muted small mb-1">Invoice receipt</div>
                                <div>@Model.InvoiceReceiptMethod.Name()</div>
                            </div>

                            @if (billingContacts.Any())
                            {
                                <div class="crm-side-card mb-3">
                                    <div class="text-muted small mb-1">Billing contact</div>
                                    @foreach (var contact in billingContacts)
                                    {
                                        <div>
                                            <strong>@contact.DisplayName</strong>
                                            @if (!string.IsNullOrWhiteSpace(contact.Email))
                                            {
                                                <span class="text-muted">— @contact.Email</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                            {
                                                <span class="text-muted">— @contact.Phone</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (Model.Contracts.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-4">
                                        <thead>
                                            <tr>
                                                <th>Contract</th>
                                                <th>Bill months</th>
                                                <th>Service months</th>
                                                <th>Routes</th>
                                                <th>Next Bill</th>
                                                <th>Ends</th>
                                                <th class="text-end">Total</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var contract in Model.Contracts.OrderBy(b => b.NextBillDate).ThenBy(b => b.ContractName))
                                        {
                                            var routes = contract.ContractRoutes.OrderBy(cbr => cbr.Route.RouteName).ToList();
                                            var total = routes.Sum(AnnualBillingHelper.GetBillingAmount);
                                            var isExpired = contract.ContractEndDate.HasValue && contract.ContractEndDate.Value < DateOnly.FromDateTime(DateTime.Today);
                                            <tr class="@(isExpired ? "text-muted" : "")">
                                                <td>
                                                    @contract.ContractName
                                                    @if (!string.IsNullOrWhiteSpace(contract.WaveInvoiceNumber) || contract.HasWaveInvoicePdf)
                                                    {
                                                        <div class="small">
                                                            @if (!string.IsNullOrWhiteSpace(contract.WaveInvoiceNumber))
                                                            {
                                                                <span class="text-muted">Wave @contract.WaveInvoiceNumber</span>
                                                            }
                                                            @if (contract.HasWaveInvoicePdf)
                                                            {
                                                                <a asp-controller="CustomerContracts" asp-action="InvoicePdf" asp-route-id="@contract.Id" class="ms-1">PDF</a>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                                <td>@BillingTermDisplay.Label(contract)</td>
                                                <td>@SubscribedMonths.Format(contract.ServiceMonthMask)</td>
                                                <td>
                                                    @if (routes.Any())
                                                    {
                                                        <ul class="mb-0 ps-3">
                                                        @foreach (var cbr in routes)
                                                        {
                                                            <li>
                                                                <a asp-controller="Routes" asp-action="Details" asp-route-id="@cbr.Route.Id">@cbr.Route.RouteName</a>
                                                                <span class="text-muted">(@AnnualBillingHelper.GetBillingAmount(cbr).ToString("C"))</span>
                                                            </li>
                                                        }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No routes</span>
                                                    }
                                                </td>
                                                <td>@contract.NextBillDate.ToString("MMM d, yyyy")</td>
                                                <td>
                                                    @BillingDueCalculator.FormatContractEndDate(contract.ContractEndDate)
                                                    @if (isExpired)
                                                    {
                                                        <span class="badge bg-secondary ms-1">Expired</span>
                                                    }
                                                </td>
                                                <td class="text-end">@total.ToString("C")</td>
                                                <td class="text-end text-nowrap">
                                                    <a asp-controller="CustomerContracts" asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                                    <a asp-controller="CustomerContracts" asp-action="Delete" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                        <tfoot class="table-light fw-semibold">
                                            <tr>
                                                <td colspan="6" class="text-end">All contracts total</td>
                                                <td class="text-end">
                                                    @(Model.Contracts
                                                        .SelectMany(b => b.ContractRoutes)
                                                        .Sum(AnnualBillingHelper.GetBillingAmount)
                                                        .ToString("C"))
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No contracts yet.</p>
                            }

                            <div class="fw-semibold mb-2">Active routes</div>
                            @if (activeContractRoutes.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Route</th>
                                                <th>Contract</th>
                                                <th>Billing</th>
                                                <th>Service months</th>
                                                <th class="text-end">Invoice</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var item in activeContractRoutes)
                                        {
                                            var amount = AnnualBillingHelper.GetBillingAmount(item.ContractRoute);
                                            <tr>
                                                <td><a asp-controller="Routes" asp-action="Details" asp-route-id="@item.ContractRoute.RouteId">@item.ContractRoute.Route.RouteName</a></td>
                                                <td>@item.Contract.ContractName</td>
                                                <td>@BillingTermDisplay.Label(item.Contract)</td>
                                                <td>@SubscribedMonths.Format(item.Contract.ServiceMonthMask)</td>
                                                <td class="text-end">@amount.ToString("C")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No routes on active contracts.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4 order-1 order-lg-1">
            @if (latestBrochure != null)
            {
                <div class="crm-side-card mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="crm-side-title mb-0">Brochure</div>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="tab" data-bs-target="#tab-brochures" id="side-brochure-tab-link">View all</button>
                    </div>
                    @if (latestBrochure.IsImage)
                    {
                        <button type="button"
                                class="brochure-scan-preview crm-side-thumb brochure-preview-trigger"
                                data-bs-toggle="modal"
                                data-bs-target="#brochurePreviewModal"
                                data-brochure-url="@Url.Action("ViewBrochureScan", new { id = latestBrochure.Id })"
                                data-brochure-title="@latestBrochure.OriginalFileName"
                                data-brochure-type="image">
                            <img src="@Url.Action("ViewBrochureScan", new { id = latestBrochure.Id })" class="brochure-scan-thumb" alt="@latestBrochure.OriginalFileName" />
                        </button>
                    }
                    else
                    {
                        <div class="brochure-scan-preview brochure-scan-preview-pdf text-center py-4">
                            <div class="fw-semibold mb-2">PDF</div>
                            <div class="small text-muted mb-2 text-truncate" title="@latestBrochure.OriginalFileName">@latestBrochure.OriginalFileName</div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary brochure-preview-trigger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#brochurePreviewModal"
                                    data-brochure-url="@Url.Action("ViewBrochureScan", new { id = latestBrochure.Id })"
                                    data-brochure-title="@latestBrochure.OriginalFileName"
                                    data-brochure-type="pdf">
                                Open PDF
                            </button>
                        </div>
                    }
                    <div class="small text-muted mt-2">Uploaded @latestBrochure.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.WarehouseLocationLabel))
                    {
                        <div class="small mt-1">Warehouse @Model.WarehouseLocationLabel</div>
                    }
                </div>
            }

            <div class="crm-side-card mb-3">
                <div class="crm-side-title">About</div>
                <dl class="crm-meta mb-0">
                    <div>
                        <dt>Type</dt>
                        <dd>@Model.Type</dd>
                    </div>
                    <div>
                        <dt>Status</dt>
                        <dd>@Model.Status</dd>
                    </div>
                    <div>
                        <dt>Address</dt>
                        <dd>@(Model.Address ?? "—")</dd>
                    </div>
                    <div>
                        <dt>City</dt>
                        <dd>@(Model.City ?? "—")</dd>
                    </div>
                    <div>
                        <dt>State</dt>
                        <dd>@(Model.State ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Zip</dt>
                        <dd>@(Model.Zip ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Coordinates</dt>
                        <dd>
                            @(Model.Latitude.HasValue && Model.Longitude.HasValue
                                ? $"{Model.Latitude:0.######}, {Model.Longitude:0.######}"
                                : "—")
                        </dd>
                    </div>
                    <div>
                        <dt>Phone</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <a href="tel:@Model.Phone">@Model.Phone</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Invoice receipt</dt>
                        <dd>@Model.InvoiceReceiptMethod.Name()</dd>
                    </div>
                    <div>
                        <dt>Web URL</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(Model.WebUrl))
                            {
                                <a href="@Model.WebUrl" target="_blank" rel="noopener noreferrer">@Model.WebUrl</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Account manager</dt>
                        <dd>@(Model.AccountManager?.DisplayName ?? Model.AccountManager?.Email ?? "—")</dd>
                    </div>
                    @if (Model.Type == CustomerType.ExpandedProspect)
                    {
                        <div>
                            <dt>Target route</dt>
                            <dd>
                                @if (Model.ExpandedProspectRoute != null)
                                {
                                    <a asp-controller="Routes" asp-action="Details" asp-route-id="@Model.ExpandedProspectRoute.Id">@Model.ExpandedProspectRoute.RouteName</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </dd>
                        </div>
                    }
                    @if (!isProspectLike)
                    {
                        <div>
                            <dt>Annual revenue</dt>
                            <dd>@(((decimal?)ViewBag.AnnualRevenue ?? 0m).ToString("C0"))</dd>
                        </div>
                        <div>
                            <dt>Contracts</dt>
                            <dd>@Model.Contracts.Count</dd>
                        </div>
                        <div>
                            <dt>Active routes</dt>
                            <dd>@activeContractRoutes.Count</dd>
                        </div>
                    }
                    @if (Model.NeedsMoreInfo)
                    {
                        <div>
                            <dt>Needs more info</dt>
                            <dd>Yes — missing an address or map coordinates</dd>
                        </div>
                    }
                    @if (isProspectLike)
                    {
                        var proximity = ViewBag.HighValueProximity as HighValueProximityHit;
                        if (Model.IsHighValueProspect || proximity != null)
                        {
                            <div>
                                <dt>High value</dt>
                                <dd>
                                    <span>@(Model.IsHighValueProspect ? "Yes" : "Nearby")</span>
                                    @if (proximity != null)
                                    {
                                        <div class="small text-muted">@proximity.Summary</div>
                                    }
                                </dd>
                            </div>
                        }
                    }
                </dl>
            </div>

            <div class="crm-side-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="crm-side-title mb-0">Primary contact</div>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addContactModal">Add</button>
                </div>
                @if (primaryContact != null)
                {
                    <div class="fw-semibold">@primaryContact.Name</div>
                    <div class="small text-muted mb-1">@primaryContact.Role</div>
                    <div class="small">@(primaryContact.Email ?? "—")</div>
                    <div class="small">@(primaryContact.Phone ?? "—")</div>
                    <div class="small text-muted">@string.Join(", ", new[] { primaryContact.Address, primaryContact.City, primaryContact.State, primaryContact.Zip }.Where(s => !string.IsNullOrEmpty(s)).DefaultIfEmpty("—"))</div>
                    @if (!string.IsNullOrWhiteSpace(primaryContact.WebUrl))
                    {
                        <div class="small mt-1"><a href="@primaryContact.WebUrl" target="_blank" rel="noopener noreferrer">@primaryContact.WebUrl</a></div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No contacts yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Contacts/_CreateContactModal.cshtml" model="draftContact" />

<div class="modal fade" id="brochurePreviewModal" tabindex="-1" aria-labelledby="brochurePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-truncate" id="brochurePreviewTitle">Brochure</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body brochure-preview-body">
                <img id="brochurePreviewImage" class="brochure-preview-image d-none" alt="" />
                <iframe id="brochurePreviewPdf" class="brochure-preview-pdf d-none" title="Brochure PDF"></iframe>
            </div>
            <div class="modal-footer">
                <a id="brochurePreviewDownload" href="#" class="btn btn-outline-secondary" download>Download</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="~/js/customer-map.js" asp-append-version="true"></script>
        <script>
            AdRackCustomerMap.init({
                mapId: 'customerMap',
                tabButtonId: 'tab-map-btn',
                tabPaneId: 'tab-map'
            });
        </script>
    }
    <script>
        document.querySelectorAll('[data-bs-toggle="tab"][data-bs-target="#tab-brochures"]').forEach(function (el) {
            el.addEventListener('click', function () {
                var btn = document.getElementById('tab-brochures-btn');
                if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
            });
        });

        (function () {
            function todayValue() {
                var now = new Date();
                var month = String(now.getMonth() + 1).padStart(2, '0');
                var day = String(now.getDate()).padStart(2, '0');
                return now.getFullYear() + '-' + month + '-' + day;
            }

            function kindDefaultsDue(kind) {
                return kind === 'Task' || kind === 'BrochuresNeeded';
            }

            document.querySelectorAll('[data-activity-kind]').forEach(function (kindSelect) {
                var form = kindSelect.closest('form');
                var dueInput = form && form.querySelector('[data-activity-due]');
                if (!dueInput) return;

                function syncDueDate() {
                    if (kindDefaultsDue(kindSelect.value)) {
                        if (!dueInput.value) {
                            dueInput.value = todayValue();
                            dueInput.dataset.autoDue = '1';
                        }
                        return;
                    }
                    if (dueInput.dataset.autoDue === '1') {
                        dueInput.value = '';
                        delete dueInput.dataset.autoDue;
                    }
                }

                dueInput.addEventListener('input', function () {
                    delete dueInput.dataset.autoDue;
                });
                kindSelect.addEventListener('change', syncDueDate);
                syncDueDate();
            });
        })();

        (function () {
            var modalEl = document.getElementById('brochurePreviewModal');
            if (!modalEl) return;

            var titleEl = document.getElementById('brochurePreviewTitle');
            var imageEl = document.getElementById('brochurePreviewImage');
            var pdfEl = document.getElementById('brochurePreviewPdf');
            var downloadEl = document.getElementById('brochurePreviewDownload');

            modalEl.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                if (!trigger) return;

                var url = trigger.getAttribute('data-brochure-url') || '';
                var title = trigger.getAttribute('data-brochure-title') || 'Brochure';
                var type = trigger.getAttribute('data-brochure-type') || 'image';

                titleEl.textContent = title;
                downloadEl.href = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'download=true';
                downloadEl.setAttribute('download', title);

                if (type === 'pdf') {
                    imageEl.classList.add('d-none');
                    imageEl.removeAttribute('src');
                    pdfEl.classList.remove('d-none');
                    pdfEl.src = url;
                } else {
                    pdfEl.classList.add('d-none');
                    pdfEl.removeAttribute('src');
                    imageEl.classList.remove('d-none');
                    imageEl.src = url;
                    imageEl.alt = title;
                }
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                imageEl.removeAttribute('src');
                pdfEl.removeAttribute('src');
            });
        })();
    </script>
}
