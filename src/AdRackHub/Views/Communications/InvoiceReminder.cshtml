@model InvoiceReminderTemplatePageViewModel
@{
    ViewData["Title"] = "Invoice reminder template";
}

<div class="page-header">
    <div>
        <div class="text-muted small mb-1">Admin / Communications</div>
        <h1 class="h2 mb-0">Invoice reminder template</h1>
    </div>
</div>

<p class="text-muted">This is the default subject and body for invoice reminders. Outstanding invoices can preview and change one email before it is sent. Those edits do not change this template.</p>
<p class="mb-4">@Model.UpdatedLabel The agent API can read and render this template. It cannot change the saved template unless <code>AgentApi:CanManageInvoiceReminderTemplate</code> is set to true on the server.</p>

<form method="post" class="row g-4">
    @Html.AntiForgeryToken()
    <div class="col-lg-7">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        @if (!Model.MatchesSaved)
        {
            <div class="alert alert-warning">These edits are only on this page until you save. Preview and the test email use this text and do not change the saved template.</div>
        }
        <div class="mb-3">
            <label class="form-label" for="reminder-subject">Subject</label>
            <input class="form-control" id="reminder-subject" name="Subject" maxlength="300" value="@Model.Subject" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="reminder-body">Email body</label>
            <textarea class="form-control" id="reminder-body" name="Body" rows="18" maxlength="8000" required>@Model.Body</textarea>
        </div>
        <div class="mb-3">
            <label class="form-label" for="reminder-preview-invoice">Preview using</label>
            <select class="form-select" id="reminder-preview-invoice" name="PreviewInvoiceId">
                <option value="">Sample customer</option>
                @foreach (var choice in Model.PreviewChoices)
                {
                    if (choice.InvoiceId == Model.PreviewInvoiceId)
                    {
                        <option value="@choice.InvoiceId" selected>@choice.Label</option>
                    }
                    else
                    {
                        <option value="@choice.InvoiceId">@choice.Label</option>
                    }
                }
            </select>
            <div class="form-text">Sample data is used until you pick an outstanding invoice.</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" formaction="@Url.Action("SaveInvoiceReminder")">Save template</button>
            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("PreviewInvoiceReminder")">Preview</button>
            <button type="submit" class="btn btn-outline-primary" formaction="@Url.Action("SendInvoiceReminderTest")"
                    @(Model.MailgunConfigured ? null : "disabled")
                    title="@(Model.MailgunConfigured ? $"Send this preview to {Model.TestRecipient}" : "Mailgun is not configured.")">
                Send test to @Model.TestRecipient
            </button>
        </div>
        @if (!Model.MailgunConfigured)
        {
            <p class="text-muted small mt-2 mb-0">Test email is off until Mailgun has an API key.</p>
        }
    </div>
    <div class="col-lg-5">
        <h2 class="h6">Merge fields</h2>
        <ul class="small ps-3">
            @foreach (var field in Model.MergeFields)
            {
                <li class="mb-1"><code>@field.Token</code> — @field.Description</li>
            }
        </ul>
        @if (Model.HasPreview)
        {
            <partial name="_InvoiceReminderPreview" model="(Model.PreviewSubject, Model.PreviewBody, Model.LogoUrl, Model.PreviewSourceLabel)" />
        }
    </div>
</form>

<form method="post" asp-action="RestoreInvoiceReminder" class="mt-3"
      onsubmit="return confirm('Restore the original system default? This saved template will be replaced. The change is kept in the history.');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-danger">Restore original default</button>
</form>

<h2 class="h5 mt-5">Change history</h2>
@if (Model.History.Count == 0)
{
    <p class="text-muted">No one has changed the template yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Who</th>
                    <th>Change</th>
                    <th>Subject</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var revision in Model.History)
            {
                <tr>
                    <td class="text-nowrap">@revision.When</td>
                    <td>@revision.Who</td>
                    <td>@revision.Change</td>
                    <td>@revision.Subject</td>
                    <td>
                        <details>
                            <summary>Body</summary>
                            <pre class="small mb-0 mt-2" style="white-space: pre-wrap;">@revision.Body</pre>
                        </details>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
