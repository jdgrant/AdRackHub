@model (string? Subject, string? Body, string? LogoUrl, string SourceLabel)
<div class="card">
    <div class="card-header">Preview · @Model.SourceLabel</div>
    <div class="card-body">
        <div class="text-muted small mb-2">@Model.Subject</div>
        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.45; color: #111; white-space: pre-wrap;">@if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
{<img src="@Model.LogoUrl" alt="Ad-Rack" width="220" class="d-block mb-3" />}@Model.Body</div>
    </div>
</div>
