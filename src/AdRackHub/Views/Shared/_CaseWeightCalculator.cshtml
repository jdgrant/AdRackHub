@model string
@using System.Globalization
@using System.Text.Json
@using AdRackHub.Services
@{
    var apply = string.Equals(Model, "inventory", StringComparison.OrdinalIgnoreCase) ? "inventory" : "customer";
    var prefix = apply == "inventory" ? "case-weight-inventory" : "case-weight-customer";
    var boardJson = JsonSerializer.Serialize(
        BrochureCaseWeight.Boards.Select(board => new { id = board.Id, lb = board.PoundsPerThousandSquareFeet }));
}
<div class="card mb-3" id="@prefix"
     data-case-calculator
     data-apply="@apply"
     data-joint="@BrochureCaseWeight.JointInches.ToString(CultureInfo.InvariantCulture)"
     data-boards="@boardJson">
    <div class="card-body">
        <div class="fw-semibold mb-1">Case weight calculator</div>
        <p class="text-muted small mb-3">Weigh a sample of brochures, then weigh the full case. The box weight is estimated from the outside size, so you do not need an empty carton of every size. Type a measured empty-box weight when you have one.</p>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <label class="form-label" for="@prefix-sample-count">Brochures on the scale</label>
                <input id="@prefix-sample-count" data-sample-count value="10" inputmode="numeric" class="form-control" autocomplete="off" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="@prefix-sample-weight">Their weight</label>
                <div class="input-group">
                    <input id="@prefix-sample-weight" data-sample-weight inputmode="decimal" class="form-control" autocomplete="off" />
                    <select data-sample-unit class="form-select" style="max-width: 5.5rem;" aria-label="Sample weight unit">
                        <option value="oz" selected>oz</option>
                        <option value="lb">lb</option>
                    </select>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="@prefix-gross">Full case weight</label>
                <div class="input-group">
                    <input id="@prefix-gross" data-gross-weight inputmode="decimal" class="form-control" autocomplete="off" />
                    <select data-gross-unit class="form-select" style="max-width: 5.5rem;" aria-label="Case weight unit">
                        <option value="lb" selected>lb</option>
                        <option value="oz">oz</option>
                    </select>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="@prefix-cases">Cases like this</label>
                <input id="@prefix-cases" data-case-qty value="1" inputmode="numeric" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-4 col-md-2">
                <label class="form-label" for="@prefix-length">Length (in)</label>
                <input id="@prefix-length" data-length inputmode="decimal" class="form-control" autocomplete="off" />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label" for="@prefix-width">Width (in)</label>
                <input id="@prefix-width" data-width inputmode="decimal" class="form-control" autocomplete="off" />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label" for="@prefix-height">Height (in)</label>
                <input id="@prefix-height" data-height inputmode="decimal" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="@prefix-board">Board</label>
                <select id="@prefix-board" data-board class="form-select">
                    @foreach (var board in BrochureCaseWeight.Boards)
                    {
                        <option value="@board.Id">@board.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-none" data-custom-board>
                <label class="form-label" for="@prefix-msf">Board lb per 1,000 sq ft</label>
                <input id="@prefix-msf" data-custom-msf inputmode="decimal" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-md-4">
                <label class="form-label" for="@prefix-tare">Measured empty box</label>
                <div class="input-group">
                    <input id="@prefix-tare" data-tare inputmode="decimal" class="form-control" autocomplete="off" placeholder="Optional" />
                    <select data-tare-unit class="form-select" style="max-width: 5.5rem;" aria-label="Empty box weight unit">
                        <option value="lb" selected>lb</option>
                        <option value="oz">oz</option>
                    </select>
                </div>
                <div class="form-text">Overrides the size estimate.</div>
            </div>
        </div>

        <p class="text-muted small mt-3 mb-0" data-hint>Enter the sample weight and the full case weight.</p>
        <div class="mt-3 d-none" data-result>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Each brochure</div>
                    <div class="fw-semibold" data-out-each></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Box tare</div>
                    <div class="fw-semibold" data-out-tare></div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Case count</div>
                    <div class="fw-semibold" data-out-count></div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Cases</div>
                    <div class="fw-semibold" data-out-cases></div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Total</div>
                    <div class="fw-semibold" data-out-total></div>
                </div>
            </div>
            <div class="alert alert-warning mt-3 mb-0 d-none" data-out-warning></div>
        </div>
        <div class="alert alert-danger mt-3 mb-0 d-none" data-out-error></div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            @if (apply == "inventory")
            {
                <select class="form-select" style="max-width: 22rem;" data-target-row aria-label="Customer to fill">
                    <option value="">Choose a customer</option>
                </select>
                <button type="button" class="btn btn-outline-primary" data-apply-row disabled>Apply to customer</button>
            }
            else
            {
                <button type="button" class="btn btn-outline-primary" data-apply-kind="Received" disabled>Fill as received</button>
                <button type="button" class="btn btn-outline-secondary" data-apply-kind="Count" disabled>Fill as inventory count</button>
            }
        </div>

        <details class="mt-3">
            <summary class="small">How the box weight is estimated</summary>
            <p class="text-muted small mt-2 mb-0">@BrochureCaseWeight.FormulaSummary Board weights already include flute take-up and glue for single-wall C-flute. A measured empty box is the better tare when you have one of that size.</p>
        </details>
    </div>
</div>
