<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdRackHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdRackHub.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">AdRackHub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole(AppRoles.Dashboard) || User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Customers) || User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Prospects" asp-action="Index">Prospects</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Billing" asp-action="Index">Billing</a></li>
                        }
                        @if (User.IsInRole(AppRoles.RoutesStops) || User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Routes & Stops</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Routes" asp-action="Index">Routes</a></li>
                                <li><a class="dropdown-item" asp-controller="Stops" asp-action="Index">Stops</a></li>
                                <li><a class="dropdown-item" asp-controller="GoogleSheets" asp-action="Index">Google Sheets</a></li>
                            </ul>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container">
            &copy; 2026 AdRackHub
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
