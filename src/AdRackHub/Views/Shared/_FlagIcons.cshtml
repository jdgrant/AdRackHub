@model Customer
@{
    var showHighValue = Model.Type == CustomerType.Prospect && Model.IsHighValueProspect;
    var showAtRisk = Model.Type == CustomerType.Customer && Model.IsAtRisk;
    var size = ViewData["IconSize"] as string ?? "md";
    var sizeClass = size == "sm" ? "crm-flag-icon-sm" : "crm-flag-icon";
}
@if (showHighValue)
{
    <span class="@sizeClass crm-flag-high-value" title="High Value Prospect" aria-label="High Value Prospect">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
        </svg>
    </span>
}
@if (showAtRisk)
{
    <span class="@sizeClass crm-flag-at-risk" title="At Risk" aria-label="At Risk">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
    </span>
}
