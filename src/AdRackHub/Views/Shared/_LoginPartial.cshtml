@using Microsoft.AspNetCore.Identity
@inject SignInManager<AdRackHub.Models.ApplicationUser> SignInManager
@inject UserManager<AdRackHub.Models.ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <li class="nav-item">
        <span class="navbar-text me-3">@(user?.DisplayName ?? user?.Email)</span>
    </li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link nav-link">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
    </li>
}
</ul>
