@using AdRackHub.Models
@model BillingForecastPageViewModel
@{
    ViewData["Title"] = "Billing forecast";
}

<div class="page-header">
    <h1 class="h2 mb-0">Billing forecast</h1>
    <div class="d-flex flex-wrap gap-3 align-items-center">
        <form method="get" asp-action="Forecast" class="form-check form-switch mb-0">
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="month" value="@Model.Month" />
            <input class="form-check-input" type="checkbox" role="switch" id="useProposals" name="useProposals" value="true"
                   @(Model.UseProposals ? "checked" : null) onchange="this.form.submit()" />
            <label class="form-check-label" for="useProposals">Use a proposal instead of an assumed renewal</label>
        </form>
        <a asp-action="Outstanding" class="btn btn-outline-secondary">Outstanding</a>
        <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Back to Billing</a>
    </div>
</div>

<partial name="_BillingNav" />

<p class="text-muted mb-4">Each month lists who will be invoiced, and who would be invoiced if the contract renewed. When the proposal switch is on, a customer with a proposal uses that proposal instead of assuming the old contract continues.</p>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">12-month total, will be invoiced</div>
                <div class="display-6">@Model.ForecastTotal.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">12-month total, @Model.AlternateTitle.ToLowerInvariant()</div>
                <div class="display-6">@Model.IgnoredForecastTotal.ToString("C0")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-2 billing-forecast mb-4">
    @foreach (var month in Model.Months)
    {
        var ignored = Model.IgnoredFor(month.Year, month.Month);
        <div class="col-6 col-sm-4 col-lg-2">
            <a asp-action="Forecast" asp-route-year="@month.Year" asp-route-month="@month.Month" asp-route-useProposals="@(Model.UseProposals ? "true" : null)" asp-fragment="@($"month-{month.Year}-{month.Month}")" class="text-decoration-none">
                <div class="card h-100 billing-forecast-month@(month.IsSelectedPeriod ? " billing-forecast-month-selected" : "")@(month.IsCurrentMonth ? " billing-forecast-month-current" : "")">
                    <div class="card-body py-2 px-3">
                        <div class="small text-muted">@month.Label</div>
                        <div class="fw-semibold">@month.Amount.ToString("C0")</div>
                        <div class="small text-muted">@month.CustomerCount customer@(month.CustomerCount == 1 ? "" : "s")</div>
                        @if (ignored != null && ignored.Amount != month.Amount)
                        {
                            <div class="small">@(Model.UseProposals ? "Using proposals" : "If renewed") @ignored.Amount.ToString("C0")</div>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>

@foreach (var month in Model.Months)
{
    var ignored = Model.IgnoredFor(month.Year, month.Month) ?? new BillingMonthForecast { Year = month.Year, Month = month.Month, Label = month.Label };
    var actualAmounts = month.Lines.ToDictionary(line => line.ContractId, line => line.Amount);
    var willInvoice = new ForecastMonthTableModel { Title = "Will be invoiced", Month = month, LinkToBilling = true };
    var ifRenewed = new ForecastMonthTableModel { Title = Model.AlternateTitle, Month = ignored, ActualAmounts = actualAmounts };
    <section id="month-@month.Year-@month.Month" class="mb-5 @(month.IsSelectedPeriod ? "forecast-month-selected" : null)">
        <h2 class="h4 mb-3">@month.Label</h2>
        <div class="row g-3">
            <div class="col-xl-6">
                <partial name="_ForecastMonthTable" model="willInvoice" />
            </div>
            <div class="col-xl-6">
                <partial name="_ForecastMonthTable" model="ifRenewed" />
            </div>
        </div>
    </section>
}
