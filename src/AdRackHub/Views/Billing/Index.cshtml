@using AdRackHub.Services
@model BillingPageViewModel
@{
    ViewData["Title"] = "Billing";
    var monthOptions = Enumerable.Range(1, 12)
        .Select(m => new { Value = m, Label = new DateOnly(2000, m, 1).ToString("MMMM") })
        .ToList();
}

<div class="page-header">
    <h1 class="h2 mb-0">Billing</h1>
    <div>
        @if (Model.CanSendToWave)
        {
            <form asp-action="SendToWave" method="post" class="d-inline">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-primary">Send to Wave</button>
            </form>
        }
        else if (Model.CanPrepare && !Model.CanSendToWave)
        {
            <form asp-action="Prepare" method="post" class="d-inline">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-outline-primary">Prepare Invoices</button>
            </form>
        }
    </div>
</div>

@if (!Model.WaveConfigured)
{
    <div class="alert alert-warning">
        Wave API is not configured. Set <code>Wave:AccessToken</code> and <code>Wave:BusinessId</code> to send invoices.
    </div>
}
else
{
    <div class="alert alert-info py-2">
        Sending to Wave will create customers (if needed) and draft invoices via the Wave API.
        Customer details are taken from billing/primary contacts.
    </div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Billing period</label>
        <div class="input-group">
            <select name="month" class="form-select">
                @foreach (var option in monthOptions)
                {
                    <option value="@option.Value" selected="@(option.Value == Model.Month)">@option.Label</option>
                }
            </select>
            <input type="number" name="year" class="form-control" value="@Model.Year" min="2020" max="2100" style="max-width: 6rem;" />
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Go</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Period</div>
                <div class="h4 mb-0">@Model.PeriodLabel</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Contracts Due</div>
                <div class="display-6">@Model.DueContracts.Select(i => i.CustomerContractId).Distinct().Count()</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Customers</div>
                <div class="display-6">@Model.DueCustomerCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Due</div>
                <div class="display-6">@Model.DueTotal.ToString("C0")</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Run != null)
{
    <div class="alert @(Model.IsFullySubmitted ? "alert-success" : Model.Run.Status == BillingRunStatus.Failed ? "alert-danger" : "alert-info") d-flex justify-content-between align-items-center">
        <div>
            <strong>Run status:</strong> @Model.Run.Status
            @if (Model.Run.SubmittedAt.HasValue)
            {
                <span class="text-muted">— submitted @Model.Run.SubmittedAt.Value.ToLocalTime().ToString("g")</span>
            }
        </div>
        @if (Model.Run.Status is BillingRunStatus.PartiallySubmitted or BillingRunStatus.Failed && Model.WaveConfigured)
        {
            <form asp-action="Retry" method="post" class="mb-0">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-sm btn-outline-primary">Retry Failed</button>
            </form>
        }
    </div>
}


<h2 class="h5">Due this period</h2>
@if (Model.DueContracts.Any())
{
    @if (Model.Run?.Invoices.Any() == true)
    {
        @foreach (var invoice in Model.Run.Invoices.OrderBy(i => i.Customer.CustomerName))
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@invoice.CustomerId">
                            <strong>@invoice.Customer.CustomerName</strong>
                        </a>
                        <span class="badge @(invoice.Status switch {
                            BillingRunInvoiceStatus.Submitted => "bg-success",
                            BillingRunInvoiceStatus.Failed => "bg-danger",
                            BillingRunInvoiceStatus.Skipped => "bg-warning text-dark",
                            _ => "bg-secondary"
                        }) ms-2">@invoice.Status</span>
                    </div>
                    <div class="fw-semibold">@invoice.TotalAmount.ToString("C")</div>
                </div>
                <div class="card-body p-0">
                    @if (!string.IsNullOrWhiteSpace(invoice.ErrorMessage))
                    {
                        <div class="alert alert-warning m-3 mb-0">@invoice.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(invoice.WaveInvoiceUrl))
                    {
                        <div class="px-3 pt-3">
                            <a href="@invoice.WaveInvoiceUrl" target="_blank" rel="noopener">View in Wave</a>
                        </div>
                    }
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Contract</th>
                                <th>Term</th>
                                <th>Route</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in invoice.Lines.OrderBy(l => l.ContractName).ThenBy(l => l.RouteName))
                        {
                            <tr>
                                <td>@line.ContractName</td>
                                <td>@BillingTermDisplay.Label(line.Term)</td>
                                <td>@line.RouteName</td>
                                <td class="text-end">@line.Amount.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Contract</th>
                    <th>Term</th>
                    <th>Route</th>
                    <th class="text-end">Amount</th>
                    <th>Wave</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.DueContracts)
            {
                <tr>
                    <td>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId">@item.CustomerName</a>
                    </td>
                    <td>@item.ContractName</td>
                    <td>@BillingTermDisplay.Label(item.Term)</td>
                    <td>@item.RouteName</td>
                    <td class="text-end">@item.Amount.ToString("C")</td>
                    <td>
                        @if (WaveApiService.IsLikelyWaveCustomerId(item.WaveCustomerId))
                        {
                            <span class="text-muted small">Linked</span>
                        }
                        else
                        {
                            <span class="text-muted small">Create on send</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
            <tfoot class="table-light fw-semibold">
                <tr>
                    <td colspan="4" class="text-end">Total</td>
                    <td class="text-end">@Model.DueTotal.ToString("C")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <p class="text-muted small">Prepare invoices to group by customer before sending to Wave.</p>
    }
}
else
{
    <p class="text-muted">No contracts are due for @Model.PeriodLabel.</p>
}

<h2 class="h5 mt-4">All configured contracts</h2>
<p class="text-muted small">Every customer contract in the system. Highlighted rows are due in @Model.PeriodLabel.</p>
@if (Model.AllContracts.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Contract</th>
                <th>Term</th>
                <th>Months</th>
                <th>Routes</th>
                <th>Next Bill</th>
                <th>Ends</th>
                <th class="text-end">Amount</th>
                <th>Due</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var bill in Model.AllContracts)
        {
            <tr class="@(bill.IsDueThisPeriod ? "table-primary" : "")">
                <td>
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@bill.CustomerId">@bill.CustomerName</a>
                </td>
                <td>@bill.ContractName</td>
                <td>@BillingTermDisplay.Label(bill.Term)</td>
                <td>@SubscribedMonths.Format(bill.ServiceMonthMask)</td>
                <td>@string.Join(", ", bill.RouteNames)</td>
                <td>@bill.NextBillDate.ToString("MMM d, yyyy")</td>
                <td>@BillingDueCalculator.FormatContractEndDate(bill.ContractEndDate)</td>
                <td class="text-end">@bill.Total.ToString("C")</td>
                <td>
                    @if (bill.IsDueThisPeriod)
                    {
                        <span class="badge bg-primary">Due</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No contracts configured yet. Add a contract on a customer details page.</p>
}
