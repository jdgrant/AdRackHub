@model RouteMapViewModel
@{
    ViewData["Title"] = $"Map — {Model.RouteName}";
    var stopsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Stops,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .route-map {
            min-height: 420px;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
        }
        .map-status {
            font-size: 0.9rem;
        }
    </style>
}

<div class="page-header">
    <h1 class="h2 mb-0">@Model.RouteName — Map</h1>
    <a asp-action="Details" asp-route-id="@Model.RouteId" class="btn btn-outline-secondary">Back to Route</a>
</div>

@{
    ViewData["MapHeight"] = "70vh";
}
<partial name="_RouteStopMap" model="Model.Stops" />

@section Scripts {
    @if (Model.Stops.Any())
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="~/js/route-stop-map.js" asp-append-version="true"></script>
        <script>
            AdRackRouteMap.plot({
                mapId: 'routeMap',
                statusId: 'mapStatus',
                stops: @Html.Raw(stopsJson)
            });
        </script>
    }
}
