@model AdRackHub.Models.Route
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-8">
    <div class="mb-3">
        <label asp-for="RouteName" class="form-label"></label>
        <input asp-for="RouteName" class="form-control" />
        <span asp-validation-for="RouteName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
    </div>
    <input type="hidden" asp-for="BillingFrequency" />
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<RouteStatus>()"></select>
    </div>
</div>
