@model RouteLoadEstimatePageViewModel
@{
    ViewData["Title"] = "Estimate";
    var exits = Model.AvailableRoutes.Where(r => r.Product == RouteProduct.Exits).ToList();
    var restAreas = Model.AvailableRoutes.Where(r => r.Product == RouteProduct.RestArea).ToList();
}

<div class="page-header">
    <h1 class="h2 mb-0">Estimate</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Routes</a>
</div>

<p class="text-muted">Select routes and how many trucks you can load. Overlapping clients are grouped onto the same truck so you load those brochures once and run the routes without restocking.</p>

<form method="get" class="mb-4" id="route-estimate-form">
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <label class="form-label mb-0 fw-semibold">Routes</label>
                        <input type="search" class="form-control form-control-sm ms-auto" style="max-width: 16rem;" id="route-filter" placeholder="Filter routes" />
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="select-all-routes">Select all</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="clear-routes">Clear</button>
                    </div>
                    <div class="route-estimate-list" id="route-estimate-list">
                        @if (exits.Count > 0)
                        {
                            <div class="text-muted small fw-semibold mb-1">Hotel / exit</div>
                            @foreach (var route in exits)
                            {
                                <label class="form-check route-estimate-item" data-name="@route.Name.ToLowerInvariant()">
                                    <input class="form-check-input" type="checkbox" name="routeIds" value="@route.Id" @(route.Selected ? "checked" : null) />
                                    <span class="form-check-label">@route.Name <span class="text-muted">(@route.ActiveCustomers)</span></span>
                                </label>
                            }
                        }
                        @if (restAreas.Count > 0)
                        {
                            <div class="text-muted small fw-semibold mt-3 mb-1">Rest area</div>
                            @foreach (var route in restAreas)
                            {
                                <label class="form-check route-estimate-item" data-name="@route.Name.ToLowerInvariant()">
                                    <input class="form-check-input" type="checkbox" name="routeIds" value="@route.Id" @(route.Selected ? "checked" : null) />
                                    <span class="form-check-label">@route.Name <span class="text-muted">(@route.ActiveCustomers)</span></span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="BrochuresPerClient" class="form-label"></label>
                        <input asp-for="BrochuresPerClient" class="form-control" type="number" min="1" step="1" />
                        <div class="form-text">Copies loaded for each distinct customer on the combined run.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TruckCount" class="form-label"></label>
                        <input asp-for="TruckCount" class="form-control" type="number" min="1" max="20" step="1" />
                        <div class="form-text">Routes that share clients stay on the same truck so you do not reload between those routes.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="VanCapacity" class="form-label"></label>
                        <input asp-for="VanCapacity" class="form-control" type="number" min="1" step="1" placeholder="Optional" />
                        <div class="form-text">Optional brochure limit for one truck. Leave blank to pack only by shared clients.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Estimate load</button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.Result is { DistinctCustomers: 0 })
{
    <div class="alert alert-warning">No active customers on the selected routes.</div>
}

@if (Model.Result is { } result)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="text-muted small">Distinct customers</div>
                    <div class="display-6">@result.DistinctCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="text-muted small">Combined brochures</div>
                    <div class="display-6">@result.CombinedBrochures.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card info h-100">
                <div class="card-body">
                    <div class="text-muted small">If run separately</div>
                    <div class="display-6">@result.SeparateBrochures.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card @(result.BrochureSavings > 0 ? "warning" : "") h-100">
                <div class="card-body">
                    <div class="text-muted small">Saved by combining</div>
                    <div class="display-6">@result.BrochureSavings.ToString("N0")</div>
                    <div class="small text-muted">@result.SharedCustomers overlapping client@(result.SharedCustomers == 1 ? "" : "s")</div>
                </div>
            </div>
        </div>
    </div>

    @if (result.CombinedVans.HasValue)
    {
        <div class="alert @(result.CombinedFits ? "alert-success" : "alert-warning")">
            Combined load is @result.FillPercent?.ToString("0.#")% of one van
            (@result.CombinedBrochures.ToString("N0") / @Model.VanCapacity!.Value.ToString("N0")).
            @if (result.CombinedFits)
            {
                <span>These routes fit on <strong>1 van</strong>.</span>
            }
            else
            {
                <span>Need <strong>@result.CombinedVans</strong> van@(result.CombinedVans == 1 ? "" : "s") combined vs <strong>@result.SeparateVans</strong> if each route is its own run.</span>
            }
        </div>
    }

    @if (result.SuggestedVans.Count > 0)
    {
        <h2 class="h5 mt-4">Suggested truck loads</h2>
        <p class="text-muted small mb-2">
            Using @result.SuggestedVans.Count of @result.RequestedTrucks truck@(result.RequestedTrucks == 1 ? "" : "s").
            Each truck is grouped by overlapping clients so you load it once and run those routes without restocking.
            @if (result.CapturedSharedCustomers > 0)
            {
                <span>@result.CapturedSharedCustomers overlapping client@(result.CapturedSharedCustomers == 1 ? "" : "s") stay on one truck.</span>
            }
            @if (result.SplitCustomers > 0)
            {
                <span>@result.SplitCustomers client@(result.SplitCustomers == 1 ? "" : "s") still appear on more than one truck.</span>
            }
        </p>
        @if (result.SuggestedVans.Count > result.RequestedTrucks)
        {
            <div class="alert alert-warning">
                Capacity required @result.SuggestedVans.Count trucks. You asked for @result.RequestedTrucks.
            </div>
        }
        <div class="alert alert-light border">
            These trucks load <strong>@result.TruckBrochures.ToString("N0")</strong> brochures
            vs <strong>@result.SeparateBrochures.ToString("N0")</strong> if each route is its own run
            (@((result.SeparateBrochures - result.TruckBrochures).ToString("N0")) fewer by keeping shared clients together).
        </div>
        <div class="row g-3 mb-4">
            @foreach (var van in result.SuggestedVans)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h3 class="h6 mb-2">Truck @van.VanNumber</h3>
                                <span class="small @(van.OverCapacity ? "text-danger" : "text-muted")">
                                    @van.Brochures.ToString("N0") brochures
                                    @if (van.FillPercent.HasValue)
                                    {
                                        <text>· @van.FillPercent.Value.ToString("0.#")%</text>
                                    }
                                </span>
                            </div>
                            <div class="small mb-2">
                                <span class="fw-semibold">@van.SharedCustomers</span> shared client@(van.SharedCustomers == 1 ? "" : "s")
                                <span class="text-muted">· @van.DistinctCustomers distinct</span>
                            </div>
                            <div class="small text-muted mb-2">
                                @van.UniqueStops unique + @van.RemainderStops remainder = @van.SharedStops shared stops
                            </div>
                            <ul class="mb-0 small">
                                @foreach (var name in van.RouteNames)
                                {
                                    <li>@name</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="h5">By route</h2>
    <div class="table-responsive mb-4">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Route</th>
                    <th class="text-end">Customers</th>
                    <th class="text-end">Only this combo</th>
                    <th class="text-end">Shared</th>
                    <th class="text-end">Unique stops</th>
                    <th class="text-end">Remainder</th>
                    <th class="text-end">Shared stops</th>
                    <th class="text-end">Brochures alone</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var route in result.Routes)
            {
                <tr>
                    <td>@route.RouteName</td>
                    <td class="text-end">@route.Customers</td>
                    <td class="text-end">@route.ExclusiveCustomers</td>
                    <td class="text-end">@route.SharedCustomers</td>
                    <td class="text-end">@route.UniqueStops</td>
                    <td class="text-end">@route.RemainderStops</td>
                    <td class="text-end">@route.SharedStops</td>
                    <td class="text-end">@route.BrochuresIfAlone.ToString("N0")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="table-light fw-semibold">
                    <td>Combined total</td>
                    <td class="text-end">@result.DistinctCustomers</td>
                    <td class="text-end">@result.Routes.Sum(r => r.ExclusiveCustomers)</td>
                    <td class="text-end">@result.SharedCustomers</td>
                    <td class="text-end">@result.UniqueStops</td>
                    <td class="text-end">@result.RemainderStops</td>
                    <td class="text-end">@result.SharedStops</td>
                    <td class="text-end">@result.CombinedBrochures.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <h2 class="h5">Distinct customers</h2>
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>ID</th>
                    <th>Warehouse</th>
                    <th>Routes</th>
                    <th>Trucks</th>
                    <th class="text-end">Brochures</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var customer in result.Customers)
            {
                <tr class="@(customer.TruckNumbers.Count > 1 ? "table-danger" : customer.RouteNames.Count > 1 ? "table-warning" : null)">
                    <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.CustomerId">@customer.CustomerName</a></td>
                    <td>@(string.IsNullOrWhiteSpace(customer.BrochureCode) ? "—" : customer.BrochureCode)</td>
                    <td>@(string.IsNullOrWhiteSpace(customer.Warehouse) ? "—" : customer.Warehouse)</td>
                    <td>@string.Join(", ", customer.RouteNames)</td>
                    <td>@(customer.TruckNumbers.Count == 0 ? "—" : string.Join(", ", customer.TruckNumbers.Select(n => $"Truck {n}")))</td>
                    <td class="text-end">@customer.Brochures.ToString("N0")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="table-light fw-semibold">
                    <td>Total</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td class="text-end">@result.DistinctCustomers clients</td>
                    <td class="text-end">@result.CombinedBrochures.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const filter = document.getElementById('route-filter');
            const list = document.getElementById('route-estimate-list');
            filter?.addEventListener('input', () => {
                const q = filter.value.trim().toLowerCase();
                list.querySelectorAll('.route-estimate-item').forEach(item => {
                    const name = item.getAttribute('data-name') || '';
                    item.classList.toggle('d-none', q.length > 0 && !name.includes(q));
                });
            });
            document.getElementById('select-all-routes')?.addEventListener('click', () => {
                list.querySelectorAll('.route-estimate-item:not(.d-none) input[type=checkbox]').forEach(box => { box.checked = true; });
            });
            document.getElementById('clear-routes')?.addEventListener('click', () => {
                list.querySelectorAll('input[type=checkbox]').forEach(box => { box.checked = false; });
            });
        })();
    </script>
}
