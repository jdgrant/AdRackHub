@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1 class="h2 mb-0">Dashboard</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-primary btn-sm">Customers</a>
        <a asp-controller="Prospects" asp-action="Index" class="btn btn-outline-primary btn-sm">Prospects</a>
        <a asp-controller="ExpandedProspects" asp-action="Index" class="btn btn-outline-primary btn-sm">Expanded Prospects</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Customers</div>
                <div class="display-6">@Model.ActiveCustomerCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="text-muted small">Prospects</div>
                <div class="display-6">@Model.ProspectCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card warning h-100">
            <div class="card-body">
                <div class="text-muted small">High Value</div>
                <div class="display-6">@Model.HighValueProspectCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card danger h-100">
            <div class="card-body">
                <div class="text-muted small">At Risk</div>
                <div class="display-6">@Model.AtRiskCustomerCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Activity pipeline</span>
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-3">
            <div class="pipeline-scope-switch">
                <label class="mb-0 @(Model.PipelineShowProspects ? "" : "is-active")" for="pipelineScope">Customers</label>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="pipelineScope" name="scope" value="prospects"
                           aria-label="Show prospect activities"
                           @(Model.PipelineShowProspects ? "checked" : null)
                           onchange="this.form.submit()" />
                </div>
                <label class="mb-0 @(Model.PipelineShowProspects ? "is-active" : "")" for="pipelineScope">Prospects</label>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small text-muted mb-0" for="pipelineDays">Due now through next</label>
                <input class="form-control form-control-sm pipeline-days-input" type="number" min="0" max="90" id="pipelineDays" name="days" value="@Model.PipelineDays" />
                <span class="small text-muted">days</span>
                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
            </div>
        </form>
    </div>
    <div class="card-body">
        <div class="pipeline-legend mb-3">
            @foreach (var kind in EnumDisplay.ActivityKinds())
            {
                <span class="pipeline-legend-item">
                    <span class="pipeline-legend-swatch kind-@kind.KindCss()"></span>
                    @kind.Name()
                </span>
            }
        </div>
        @{
            var pipelineLanes = new (string Title, List<DashboardPipelineItem> Items)[]
            {
                ("New", Model.PipelineNew),
                ("Working", Model.PipelineWorking),
                ("Done", Model.PipelineDone)
            };
        }
        <div class="pipeline" data-status-url="@Url.Action("UpdatePipelineStatus")" data-subnote-url="@Url.Action("AddPipelineSubNote")">
            @Html.AntiForgeryToken()
        @foreach (var lane in pipelineLanes)
        {
            <section class="pipeline-lane" data-status="@lane.Title">
                <div class="pipeline-lane-label">
                    <div class="fw-semibold">@lane.Title</div>
                    <div class="small text-muted pipeline-lane-count">@lane.Items.Count</div>
                </div>
                <div class="pipeline-lane-cards">
                    <div class="pipeline-empty text-muted">None in this window</div>
                    @foreach (var item in lane.Items)
                    {
                        <article class="pipeline-card kind-@item.Kind.KindCss()"
                                 data-note-id="@item.Id"
                                 data-kind="@item.Kind.KindCss()"
                                 data-href="@Url.Action("Details", "Customers", new { id = item.CustomerId, tab = "activity" })"
                                 data-customer="@item.CustomerName"
                                 data-past-due="@(item.IsOverdue ? "true" : "false")">
                                <button type="button" class="pipeline-card-note" title="Add sub-note" aria-label="Add sub-note">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-7.086a1.5 1.5 0 0 0-.44-1.06L11.147 1.44A1.5 1.5 0 0 0 10.086 1H2.5zM2 2.5a.5.5 0 0 1 .5-.5h7.586a.5.5 0 0 1 .354.146l3.414 3.414a.5.5 0 0 1 .146.354V13.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11z"/>
                                        <path d="M4.5 6a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zM4 9.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4z"/>
                                    </svg>
                                </button>
                                <div class="pipeline-card-type">@item.Kind.Name()</div>
                                <div class="pipeline-card-name">@item.CustomerName</div>
                                <div class="pipeline-card-due @(item.IsOverdue ? "is-overdue" : "")">
                                    @(item.DueDate?.ToString("MMM d") ?? "No due date")
                                    <span class="pipeline-overdue-label @(item.IsOverdue ? "" : "d-none")">overdue</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Preview))
                                {
                                    <div class="pipeline-card-preview">@item.Preview</div>
                                }
                        </article>
                    }
                </div>
            </section>
        }
        </div>
        <p class="small text-muted mb-0 mt-3">Shows @(Model.PipelineShowProspects ? "prospect" : "customer") activities due today through the next @Model.PipelineDays day@(Model.PipelineDays == 1 ? "" : "s"). Notes, calls, emails, meetings, and actions appear only if a due date is set. Task and Brochures Needed get today as the default due date. Overdue New and Working items stay in this window. Brochures Needed without a due date stay until Done. Done items from the last @Model.PipelineDays day@(Model.PipelineDays == 1 ? "" : "s") stay in this window.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <span class="crm-flag-icon-sm crm-flag-at-risk me-1" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                    </span>
                    At Risk Customers
                </span>
                <span class="badge bg-danger">@Model.AtRiskCustomerCount</span>
            </div>
            <div class="card-body p-0">
                @if (Model.AtRiskCustomers.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.AtRiskCustomers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                <span class="badge @(item.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@item.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No customers marked at risk.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <span class="crm-flag-icon-sm crm-flag-high-value me-1" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
                            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                        </svg>
                    </span>
                    High Value Prospects
                </span>
                <span class="badge crm-badge-high-value">@Model.HighValueProspectCount</span>
            </div>
            <div class="card-body p-0">
                @if (Model.HighValueProspects.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.HighValueProspects)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                <span class="badge @(item.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@item.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No high value prospects marked.</p>
                }
            </div>
        </div>
    </div>
</div>

<details class="dashboard-routes">
    <summary class="dashboard-routes-summary">
        Routes
        <span class="text-muted fw-normal ms-2">@Model.ActiveRouteCount active · @Model.ActiveStopCount stops</span>
    </summary>
    <div class="card mt-2">
        <div class="card-body p-0">
            @if (Model.Routes.Any())
            {
                <table class="table mb-0 table-sm">
                    <thead>
                        <tr>
                            <th>Route</th>
                            <th>Annual Revenue</th>
                            <th>Stops</th>
                            <th>Customers</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var route in Model.Routes)
                    {
                        <tr>
                            <td><a asp-controller="Routes" asp-action="Details" asp-route-id="@route.RouteId">@route.RouteName</a></td>
                            <td>@route.AnnualRevenue.ToString("C0")</td>
                            <td>@route.StopCount</td>
                            <td>@route.CustomerCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No active routes.</p>
            }
        </div>
    </div>
</details>

<div class="modal fade" id="pipelineSubNoteModal" tabindex="-1" aria-labelledby="pipelineSubNoteTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pipelineSubNoteTitle">Add sub-note</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted mb-2" id="pipelineSubNoteTarget"></div>
                <label class="form-label" for="pipelineSubNoteBody">Sub-note</label>
                <textarea class="form-control" id="pipelineSubNoteBody" rows="4" maxlength="2000" required placeholder="Add a sub-note…"></textarea>
                <div class="text-danger small mt-2 d-none" id="pipelineSubNoteError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="pipelineSubNoteSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/activity-pipeline.js" asp-append-version="true"></script>
}
