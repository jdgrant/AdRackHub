@model ReportsIndexViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <h1 class="h2 mb-0">Reports</h1>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Hotel customers</h2>
                <p class="text-muted small flex-grow-1">Customers by hotel route, with distribution dates and driver notes.</p>
                <a asp-action="HotelCustomersPdf" class="btn btn-outline-primary">Download PDF</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Rest area locations</h2>
                <p class="text-muted small flex-grow-1">Customers grouped by rest area stop, with distribution period and driver notes.</p>
                <a asp-action="RestAreaCustomersPdf" class="btn btn-outline-primary">Download PDF</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Brochure labels</h2>
                <p class="text-muted small flex-grow-1">Pick a route or search clients, then print nametag-style warehouse labels for only those selected.</p>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#brochureLabelsModal">
                    Print labels
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Tote labels</h2>
                <p class="text-muted small flex-grow-1">Same 4.3&quot; width as nametags, 2&quot; high. Client name, warehouse location, and driver notes at the bottom.</p>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#brochureLabelsModal">
                    Print tote labels
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Warehouse spreadsheet</h2>
                <p class="text-muted small flex-grow-1">Working Excel file of rack/bin locations and counts, for walkthrough updates.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="WarehouseSheet" class="btn btn-outline-primary">Download Excel</a>
                    <a asp-controller="Customers" asp-action="ImportWarehouse" class="btn btn-outline-secondary">Import</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Find on LinkedIn</h2>
                <p class="text-muted small flex-grow-1">Search LinkedIn for named customer and prospect contacts.</p>
                <a asp-controller="Contacts" asp-action="LinkedIn" class="btn btn-outline-primary">Open list</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Warehouse inventory</h2>
                <p class="text-muted small flex-grow-1">
                    Select a warehouse, update brochure counts for every customer at once, or print Kentucky, Ohio, and unassigned count sheets.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Routes" asp-action="Inventory" class="btn btn-outline-primary">Update inventory</a>
                    <a asp-action="Inventory" class="btn btn-outline-secondary">Browse last counts</a>
                    <a asp-action="WarehouseInventoryPdf" class="btn btn-outline-secondary">Count sheet PDF</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Inventory by route</h2>
                <p class="text-muted small flex-grow-1">The same last counts, grouped by each customer’s active routes, with a count sheet per route.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="InventoryByRoute" class="btn btn-outline-primary">Open report</a>
                    <a asp-action="RouteInventoryPdf" class="btn btn-outline-secondary">Count sheet PDF</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">Active contracts with no inventory</h2>
                <p class="text-muted small flex-grow-1">Contracts still in effect whose customer has never had a brochure inventory record.</p>
                <a asp-action="ContractsWithoutInventory" class="btn btn-outline-primary">Open report</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brochureLabelsModal" tabindex="-1" aria-labelledby="brochureLabelsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="BrochureLabelsPdf" method="post" id="brochure-labels-form">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="brochureLabelsModalTitle">Print labels</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Only selected clients are printed. Choose a route to show and select everyone on it. Nametags include the brochure thumbnail; tote labels are 2&quot; high with client and location. Driver notes print at the bottom of both.</p>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="brochure-label-route">Route</label>
                            <select id="brochure-label-route" class="form-select">
                                <option value="">All routes</option>
                                @foreach (var route in Model.LabelRoutes)
                                {
                                    <option value="@route.Id">@route.RouteName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="brochure-label-search">Search clients</label>
                            <input type="search" id="brochure-label-search" class="form-control" placeholder="Name or brochure ID..." autocomplete="off" />
                        </div>
                    </div>
                    @if (Model.LabelClients.Count == 0)
                    {
                        <p class="text-muted mb-0">No active customers to print labels for.</p>
                    }
                    else
                    {
                        <div class="brochure-label-grid">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 2.25rem;">
                                            <input type="checkbox" class="form-check-input" id="brochure-label-select-all"
                                                   title="Select visible clients" aria-label="Select visible clients" />
                                        </th>
                                        <th>Client</th>
                                        <th class="text-nowrap">Last update</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var client in Model.LabelClients)
                                {
                                    var search = $"{client.CustomerName} {client.BrochureCode} {string.Join(" ", client.RouteNames)}".ToLowerInvariant();
                                    <tr data-label-row data-search="@search" data-route-ids="@string.Join(" ", client.RouteIds)">
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input brochure-label-check"
                                                   name="customerIds" value="@client.Id"
                                                   aria-label="Select @client.CustomerName" />
                                        </td>
                                        <td>
                                            <div>@client.CustomerName</div>
                                            @if (!string.IsNullOrWhiteSpace(client.BrochureCode))
                                            {
                                                <div class="small text-muted">@client.BrochureCode</div>
                                            }
                                            @if (client.RouteNames.Count > 0)
                                            {
                                                <div class="small text-muted">@string.Join(" · ", client.RouteNames)</div>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            @(client.LastUpdated?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted small mt-2 mb-0" id="brochure-label-empty" hidden>No clients match that route or search.</p>
                    }
                </div>
                <div class="modal-footer justify-content-between">
                    <span class="text-muted small" id="brochure-label-count">0 selected</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-outline-primary brochure-label-print" disabled>Print nametags</button>
                        <button type="submit" class="btn btn-primary brochure-label-print" asp-action="ToteLabelsPdf" disabled>Print tote labels</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var search = document.getElementById('brochure-label-search');
            var routeSelect = document.getElementById('brochure-label-route');
            var selectAll = document.getElementById('brochure-label-select-all');
            var printBtns = Array.prototype.slice.call(document.querySelectorAll('.brochure-label-print'));
            var countEl = document.getElementById('brochure-label-count');
            var emptyEl = document.getElementById('brochure-label-empty');
            var rows = Array.prototype.slice.call(document.querySelectorAll('[data-label-row]'));
            if (!search || rows.length === 0) return;

            function visibleRows() {
                return rows.filter(function (row) { return !row.hidden; });
            }

            function onRoute(row, routeId) {
                if (!routeId) return true;
                var ids = (row.getAttribute('data-route-ids') || '').split(/\s+/);
                return ids.indexOf(routeId) !== -1;
            }

            function sync() {
                var query = (search.value || '').trim().toLowerCase();
                var routeId = routeSelect ? routeSelect.value : '';
                var shown = 0;
                rows.forEach(function (row) {
                    var match = (!query || (row.getAttribute('data-search') || '').indexOf(query) !== -1)
                        && onRoute(row, routeId);
                    row.hidden = !match;
                    if (match) shown += 1;
                });
                if (emptyEl) emptyEl.hidden = shown !== 0;

                var visible = visibleRows();
                var visibleChecked = visible.filter(function (row) {
                    var box = row.querySelector('.brochure-label-check');
                    return box && box.checked;
                }).length;
                if (selectAll) {
                    selectAll.checked = visible.length > 0 && visibleChecked === visible.length;
                    selectAll.indeterminate = visibleChecked > 0 && visibleChecked < visible.length;
                }

                var selected = document.querySelectorAll('.brochure-label-check:checked').length;
                if (countEl) countEl.textContent = selected + ' selected';
                printBtns.forEach(function (btn) { btn.disabled = selected === 0; });
            }

            search.addEventListener('input', sync);
            if (routeSelect) {
                routeSelect.addEventListener('change', function () {
                    sync();
                    if (!routeSelect.value) return;
                    visibleRows().forEach(function (row) {
                        var box = row.querySelector('.brochure-label-check');
                        if (box) box.checked = true;
                    });
                    sync();
                });
            }
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    visibleRows().forEach(function (row) {
                        var box = row.querySelector('.brochure-label-check');
                        if (box) box.checked = selectAll.checked;
                    });
                    sync();
                });
            }
            document.getElementById('brochure-labels-form').addEventListener('change', function (event) {
                if (event.target && event.target.classList.contains('brochure-label-check'))
                    sync();
            });
            sync();
        })();
    </script>
}
