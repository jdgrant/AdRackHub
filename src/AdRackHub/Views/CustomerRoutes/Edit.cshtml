@model CustomerRouteEditViewModel
@{
    ViewData["Title"] = "Edit Route Assignment";
}

<h1 class="h2 mb-4">Edit Route — @ViewBag.CustomerName</h1>
<form asp-action="Edit" method="post">
    <partial name="_CustomerRouteForm" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerRoute.CustomerId" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_CustomerRouteScripts" />
}
