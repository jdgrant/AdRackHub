@model CustomerRouteEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="CustomerRoute.Id" />
<input type="hidden" asp-for="CustomerRoute.CustomerId" />

<div class="row">
    <div class="col-lg-6">
        <div class="mb-3">
            <label asp-for="CustomerRoute.RouteId" class="form-label">Route</label>
            <select asp-for="CustomerRoute.RouteId" class="form-select" asp-items="ViewBag.RouteId" id="routeSelect"></select>
            <span asp-validation-for="CustomerRoute.RouteId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CustomerRoute.Status" class="form-label"></label>
            <select asp-for="CustomerRoute.Status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerRouteStatus>()"></select>
        </div>
        <input type="hidden" asp-for="CustomerRoute.BillingTerm" />
        @{
            var billingTermPicker = new BillingTermPickerViewModel
            {
                MonthCountInputName = "CustomerRoute.BillingMonthCount",
                MonthCountInputId = "customerRouteBillingMonthCount",
                MonthCount = Model.CustomerRoute.BillingMonthCount
            };
        }
        <partial name="_BillingTermPicker" model="billingTermPicker" />
        <span asp-validation-for="CustomerRoute.BillingMonthCount" class="text-danger"></span>
        <div class="mb-3">
            <label asp-for="CustomerRoute.RatePerMonth" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="CustomerRoute.RatePerMonth" class="form-control" id="ratePerMonthInput" step="0.01" min="0" />
            </div>
            <div class="form-text" id="routePriceHint"></div>
            <span asp-validation-for="CustomerRoute.RatePerMonth" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="CustomerRoute.AllStops" class="form-check-input" id="allStopsCheck" />
            <label asp-for="CustomerRoute.AllStops" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-lg-6">
        <label class="form-label">Months Subscribed</label>
        <div class="border rounded p-3 mb-3">
            <partial name="_SubscribedMonthsCheckboxes" model="Model.SelectedMonthNumbers" />
        </div>
        <label class="form-label">Stops on this route</label>
        <div id="stopsContainer" class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
            @for (var i = 0; i < Model.AvailableStops.Count; i++)
            {
                <div class="form-check stop-item">
                    <input type="checkbox" class="form-check-input stop-checkbox" name="SelectedStopIds" value="@Model.AvailableStops[i].StopId"
                           id="stop_@Model.AvailableStops[i].StopId" @(Model.AvailableStops[i].IsSelected ? "checked" : "") />
                    <label class="form-check-label" for="stop_@Model.AvailableStops[i].StopId">
                        @Model.AvailableStops[i].StopName
                    </label>
                </div>
            }
            @if (!Model.AvailableStops.Any())
            {
                <p class="text-muted mb-0" id="noStopsMsg">Select a route to see stops.</p>
            }
        </div>
    </div>
</div>
