@model AgentDocsPage
@{
    ViewData["Title"] = "Agent API";
}

@section Styles {
    <meta name="robots" content="noindex" />
    <style>
        .agent-doc pre {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: .5rem;
            overflow: auto;
        }
        .agent-doc code {
            font-size: .92em;
        }
        .agent-key {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }
    </style>
}

<div class="page-header">
    <h1 class="h2 mb-0">Agent API</h1>
</div>

<section class="card mb-4" id="chatgpt-plugin">
    <div class="card-body">
        <h2 class="h5">ChatGPT Work plugin</h2>
        <p>Install this as a personal plugin named <strong>Ad-Rack</strong>. ChatGPT's plugin screen does not take the REST API key. It signs in through AdRackHub with an admin account.</p>
        <ol>
            <li>Open ChatGPT and go to Plugins.</li>
            <li>Select +.</li>
            <li>Select Add custom MCP server.</li>
            <li>Name the plugin Ad-Rack.</li>
            <li>Under Connection, paste the server URL below.</li>
            <li>Set authentication to OAuth.</li>
            <li>Select Create as a plugin, then install it.</li>
            <li>When ChatGPT asks to connect, sign in to AdRackHub as an admin and choose Allow.</li>
        </ol>
        <label class="form-label" for="agent-mcp-url">MCP server URL</label>
        <div class="input-group mb-3">
            <input id="agent-mcp-url" class="form-control" readonly value="@Model.McpUrl" />
            <button class="btn btn-outline-primary" type="button" data-copy-target="agent-mcp-url">Copy</button>
        </div>
        <p class="mb-0">The tools cover customers, contacts, open activities, bills due, outstanding invoices, the billing forecast, contract end dates, the invoice reminder template, and stop visits. New records default to Prospect. Creating a Customer, or changing a Prospect to Customer, assigns a brochure ID and sends that record to Wave. Billing tools are read-only. The reminder tool can read and render the Admin template, and it cannot save it. A visit log takes the driver plus before and after photos, including images from an email. Nothing can be deleted.</p>
    </div>
</section>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Give this to ChatGPT</h2>
        <p class="mb-2">Paste this address into the chat, or tell ChatGPT to read it. It explains customers, contacts, activities, billing, and how to log a visit from an email.</p>
        <div class="input-group mb-3">
            <input id="agent-markdown-url" class="form-control" readonly value="@Model.MarkdownUrl" />
            <button class="btn btn-outline-primary" type="button" data-copy-target="agent-markdown-url">Copy</button>
        </div>
        <p class="mb-0 text-muted">Custom GPT actions can import <a href="@Model.OpenApiUrl">@Model.OpenApiUrl</a> instead. The key stays out of both documents.</p>
    </div>
</div>

@if (Model.ShowKey)
{
    <div class="card mb-4 border-warning">
        <div class="card-body">
            <h2 class="h5">API key</h2>
            <p>Put this in ChatGPT as a Bearer token. It is shown only while you are signed in as an admin.</p>
            <div class="input-group">
                <input id="agent-api-key" class="form-control agent-key" readonly value="@Model.ApiKey" />
                <button class="btn btn-outline-primary" type="button" data-copy-target="agent-api-key">Copy</button>
            </div>
        </div>
    </div>
}
else if (Model.ShowSetup)
{
    <div class="alert alert-warning">
        The REST data API returns HTTP 503 until <code>AgentApi:ApiKey</code> is set. On this machine, put it in <code>src/AdRackHub/appsettings.Development.local.json</code>. On the server, add it to <code>appsettings.Production.json</code> or set <code>AgentApi__ApiKey</code> or <code>ADRACKHUB_AGENT_API_KEY</code>, then recycle the app pool. A deploy does not upload or replace the production settings file. Do not commit the key.
    </div>
}
else if (!Model.KeyConfigured)
{
    <div class="alert alert-warning">An administrator still needs to configure the API key before ChatGPT can call the data endpoints.</div>
}
else
{
    <div class="alert alert-secondary">Ask an AdRackHub admin for the API key, then send it as <code>Authorization: Bearer &lt;key&gt;</code>.</div>
}

<article class="agent-doc">
    @Html.Raw(Model.Html)
</article>

@section Scripts {
    <script>
        document.querySelectorAll("[data-copy-target]").forEach(function (button) {
            button.addEventListener("click", function () {
                var input = document.getElementById(button.getAttribute("data-copy-target"));
                if (!input) return;
                var text = input.value;
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text);
                } else {
                    input.focus();
                    input.select();
                    document.execCommand("copy");
                }
                var original = button.textContent;
                button.textContent = "Copied";
                setTimeout(function () { button.textContent = original; }, 1500);
            });
        });
    </script>
}
