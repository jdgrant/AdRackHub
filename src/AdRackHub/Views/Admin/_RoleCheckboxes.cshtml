@model IList<string>
@{
    var selected = Model ?? new List<string>();
    var assignableRoles = AppRoles.All.Where(r => r != AppRoles.Admin).ToList();
}

<div class="mb-3">
    <label class="form-label">Roles</label>
    @foreach (var role in assignableRoles)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                   id="role-@role" @(selected.Contains(role) ? "checked" : null) />
            <label class="form-check-label" for="role-@role">@role</label>
        </div>
    }
    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@AppRoles.Admin"
               id="role-@AppRoles.Admin" @(selected.Contains(AppRoles.Admin) ? "checked" : null) />
        <label class="form-check-label" for="role-@AppRoles.Admin">@AppRoles.Admin</label>
    </div>
</div>
