@model Contact
@{
    ViewData["Title"] = "Edit Contact";
}

<h1 class="h2 mb-4">Edit Contact — @ViewBag.CustomerName</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_ContactForm" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary">Cancel</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
